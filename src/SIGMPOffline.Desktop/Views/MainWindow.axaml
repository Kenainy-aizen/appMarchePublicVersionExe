<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SIGMPOffline.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="720"
        x:Class="SIGMPOffline.Desktop.Views.MainWindow"
        x:DataType="vm:RootViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1200" Height="720"
        MinWidth="960" MinHeight="620"
        Title="SIGMP Offline — Suivi des Marchés Publics">

    <!--
        Fenêtre racine : son contenu bascule entre l'assistant de première
        configuration, l'écran de connexion et le shell applicatif (ViewLocator).
    -->
    <ContentControl Content="{Binding EcranCourant}" />
</Window>
