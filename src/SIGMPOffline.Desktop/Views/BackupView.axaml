<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SIGMPOffline.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="SIGMPOffline.Desktop.Views.BackupView"
             x:DataType="vm:BackupViewModel">

    <ScrollViewer>
        <StackPanel Spacing="16">

            <!-- En-tête -->
            <StackPanel Spacing="2">
                <TextBlock Classes="page-title" Text="Sauvegarde &amp; Restauration" />
                <TextBlock Classes="page-subtitle"
                           Text="Copiez la base sur une clé USB ou restaurez une sauvegarde." />
            </StackPanel>

            <!-- Messages -->
            <Border Classes="error" IsVisible="{Binding Erreur, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding Erreur}" TextWrapping="Wrap" />
            </Border>
            <Border Classes="success" IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
            </Border>

            <!-- Base active -->
            <Border Classes="card">
                <StackPanel Spacing="6">
                    <TextBlock Classes="section-title" Text="Base de données active" />
                    <TextBlock Classes="muted" Text="{Binding BaseDeDonneesPath}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Sauvegarde -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Classes="section-title" Text="Sauvegarder vers un support externe (clé USB)" />
                    <TextBlock Classes="muted"
                               Text="Dossier de destination (laisser vide = dossier de sauvegardes par défaut)" />
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <TextBox Text="{Binding DossierDestination}" PlaceholderText="/media/usb/SIGMP" />
                        <Button Grid.Column="1" Content="Parcourir…" Command="{Binding ParcourirDossierCommand}" />
                        <Button Grid.Column="2" Content="Sauvegarder" Command="{Binding SauvegarderCommand}" Classes="accent" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Restauration -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Classes="section-title" Text="Restaurer depuis un fichier de sauvegarde" />
                    <Border Classes="warning">
                        <TextBlock TextWrapping="Wrap"
                                   Text="La restauration remplace toutes les données actuelles par celles de la sauvegarde. Un redémarrage est recommandé ensuite." />
                    </Border>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <TextBox Text="{Binding FichierRestauration}"
                                 PlaceholderText="/media/usb/SIGMP/sigmp-backup-....db" />
                        <Button Grid.Column="1" Content="Parcourir…" Command="{Binding ParcourirFichierRestaurationCommand}" />
                        <Button Grid.Column="2" Content="Restaurer" Command="{Binding RestaurerCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
