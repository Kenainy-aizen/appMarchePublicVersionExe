<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SIGMPOffline.Desktop.ViewModels"
             xmlns:ent="using:SIGMPOffline.Domain.Entities"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1366" d:DesignHeight="760"
             x:Class="SIGMPOffline.Desktop.Views.DossierDaoView"
             x:DataType="vm:DossierDaoViewModel">

    <!--
        Module DAO en deux écrans (même page), sur le modèle du module PPM :
          1. LISTE des dossiers       -> visible quand EstEnVueDetail = false ;
          2. DÉTAIL d'un dossier      -> visible après « Ouvrir » (EstEnVueDetail = true).
    -->
    <UserControl.Styles>
        <Style Selector="Border.stat">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.stat-bar">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="TextBlock.stat-value">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="TextBlock.dossier-number">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Border.total-band">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
            <Setter Property="Padding" Value="10,10" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style Selector="Border.empty-state">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusPanel}" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" RowSpacing="12">

        <!-- ============ Messages (communs aux deux écrans) ============ -->
        <StackPanel Grid.Row="0" Spacing="8">
            <Border Classes="error"
                    IsVisible="{Binding Erreur, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding Erreur}" TextWrapping="Wrap" />
            </Border>
            <Border Classes="success"
                    IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- =====================================================================
             ÉCRAN 1 : LISTE DES DOSSIERS D'APPEL D'OFFRES
             ===================================================================== -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="14"
              IsVisible="{Binding !EstEnVueDetail}">

            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                    <TextBlock Classes="page-title" Text="DAO &amp; Attribution" />
                    <TextBlock Classes="page-subtitle"
                               Text="Un dossier par ligne de PPM. Cliquez sur « Ouvrir » pour gérer ses candidats et acheteurs." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <Button Content="Actualiser"
                            Command="{Binding ChargerCommand}" Classes="ghost"
                            IsEnabled="{Binding !EstOccupe}" />
                    <Button Content="Nouveau dossier"
                            Command="{Binding NouveauDossierCommand}" Classes="accent"
                            IsEnabled="{Binding !EstOccupe}" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="14" Margin="0,0,12,0">

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <Border Grid.Column="0" Classes="stat">
                            <Grid ColumnDefinitions="4,*">
                                <Border Classes="stat-bar" />
                                <StackPanel Grid.Column="1" Spacing="2" Margin="16,14">
                                    <TextBlock Classes="kpi-label" Text="Dossiers d'appel d'offres" />
                                    <TextBlock Classes="stat-value" Text="{Binding NombreDossiers}" />
                                    <TextBlock Classes="legende" Text="dans cette province" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Classes="stat">
                            <Grid ColumnDefinitions="4,*">
                                <Border Classes="stat-bar" />
                                <StackPanel Grid.Column="1" Spacing="2" Margin="16,14">
                                    <TextBlock Classes="kpi-label" Text="Candidats" />
                                    <TextBlock Classes="stat-value" Text="{Binding NombreCandidatsTousDossiers}" />
                                    <TextBlock Classes="legende" Text="tous dossiers confondus" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Classes="stat">
                            <Grid ColumnDefinitions="4,*">
                                <Border Classes="stat-bar" />
                                <StackPanel Grid.Column="1" Spacing="2" Margin="16,14">
                                    <TextBlock Classes="kpi-label" Text="Acheteurs DAO" />
                                    <TextBlock Classes="stat-value" Text="{Binding NombreAcheteursTousDossiers}" />
                                    <TextBlock Classes="legende" Text="cahiers des charges achetés" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Classes="card">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,10">
                                <TextBlock Classes="section-title" Text="Liste des dossiers" />
                                <TextBlock Classes="legende"
                                           Text="Ouvrir : gérer les candidats et les acheteurs. Modifier / Supprimer : agir sur le dossier." />
                            </StackPanel>

                            <Border DockPanel.Dock="Top" Classes="empty-state"
                                    IsVisible="{Binding !NombreDossiers}">
                                <StackPanel Spacing="10" HorizontalAlignment="Center">
                                    <PathIcon Data="{x:Static vm:Icones.Dao}" Width="28" Height="28"
                                              Foreground="{DynamicResource AccentBrush}"
                                              HorizontalAlignment="Center" />
                                    <TextBlock Text="Aucun dossier d'appel d'offres pour cette province."
                                               FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Classes="muted" HorizontalAlignment="Center"
                                               Text="Créez le premier dossier à partir d'une ligne de PPM." />
                                    <Button Content="Nouveau dossier" Classes="accent"
                                            HorizontalAlignment="Center"
                                            Command="{Binding NouveauDossierCommand}"
                                            IsEnabled="{Binding !EstOccupe}" />
                                </StackPanel>
                            </Border>

                            <Border DockPanel.Dock="Top" Classes="list-header">
                                <Grid ColumnDefinitions="120,*,110,80,90,128" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Text="Réf. dossier" />
                                    <TextBlock Grid.Column="1" Text="Objet et ligne PPM" />
                                    <TextBlock Grid.Column="2" Text="Créé le" />
                                    <TextBlock Grid.Column="3" Text="Candidats" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="Acheteurs" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="5" Text="Actions" HorizontalAlignment="Center" />
                                </Grid>
                            </Border>

                            <ListBox ItemsSource="{Binding Dossiers}" SelectedItem="{Binding DossierSelectionne}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="ent:DossierDao">
                                        <Grid ColumnDefinitions="120,*,110,80,90,128" ColumnSpacing="8"
                                              MinHeight="56" VerticalAlignment="Center">
                                            <TextBlock Grid.Column="0" Classes="dossier-number"
                                                       Text="{Binding RefDossier}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ObjetDossier}" TextWrapping="Wrap"
                                                           FontWeight="Medium" />
                                                <TextBlock Classes="legende" TextWrapping="Wrap">
                                                    <TextBlock.Text>
                                                        <Binding Path="PpmDetail.ObjetProjet" StringFormat="Ligne PPM : {0}" TargetNullValue="Ligne PPM : —" />
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding DateCreation, StringFormat='{}{0:dd/MM/yyyy}'}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding Candidats.Count}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding Acheteurs.Count}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Classes="icon row-action modify"
                                                        ToolTip.Tip="Ouvrir ce dossier (candidats et acheteurs)"
                                                        Command="{Binding $parent[UserControl].DataContext.OuvrirDossierCommand}"
                                                        CommandParameter="{Binding}">
                                                    <PathIcon Data="{x:Static vm:Icones.Dao}" Width="18" Height="18" />
                                                </Button>
                                                <Button Classes="icon row-action modify"
                                                        ToolTip.Tip="Modifier le dossier"
                                                        Command="{Binding $parent[UserControl].DataContext.ModifierDossierCommand}"
                                                        CommandParameter="{Binding}">
                                                    <PathIcon Data="{x:Static vm:Icones.Modifier}" Width="18" Height="18" />
                                                </Button>
                                                <Button Classes="icon row-action delete"
                                                        ToolTip.Tip="Supprimer ce dossier"
                                                        Command="{Binding $parent[UserControl].DataContext.SupprimerDossierCommand}"
                                                        CommandParameter="{Binding}">
                                                    <PathIcon Data="{x:Static vm:Icones.Supprimer}" Width="18" Height="18" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- =====================================================================
             ÉCRAN 2 : DÉTAIL D'UN DOSSIER (apparaît après « Ouvrir »)
             ===================================================================== -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="14"
              IsVisible="{Binding EstEnVueDetail}">

            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel Spacing="6">
                    <Button Content="← Retour aux dossiers" Classes="ghost" HorizontalAlignment="Left"
                            Command="{Binding RetourListeCommand}" />
                    <TextBlock Classes="page-title" Text="{Binding TitreDetailDossier}" />
                    <TextBlock Classes="page-subtitle" Text="{Binding DossierSelectionne.ObjetDossier}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                           MaxWidth="620" HorizontalAlignment="Right">
                    <Button Content="Modifier le dossier"
                            Command="{Binding ModifierDossierCommand}" Classes="ghost"
                            IsEnabled="{Binding !EstOccupe}" Margin="0,0,8,8" />
                    <Button Content="Supprimer ce dossier"
                            Command="{Binding SupprimerDossierCommand}" Classes="danger"
                            IsEnabled="{Binding !EstOccupe}" Margin="0,0,8,8" />
                    <Button Content="Ajouter un candidat"
                            Command="{Binding AjouterCandidatCommand}"
                            IsEnabled="{Binding !EstOccupe}" Margin="0,0,8,8" />
                    <Button Content="Ajouter un acheteur"
                            Command="{Binding AjouterAcheteurCommand}" Classes="accent"
                            IsEnabled="{Binding !EstOccupe}" Margin="0,0,0,8" />
                </WrapPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="14" Margin="0,0,12,0">

                    <Border Classes="panel">
                        <Grid ColumnDefinitions="2*,*,*,*" ColumnSpacing="16">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Classes="field-label" Text="Ligne de PPM" />
                                <TextBlock Text="{Binding LignePpmAffichee}"
                                           TextWrapping="Wrap" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Classes="field-label" Text="Créé le" />
                                <TextBlock Text="{Binding DossierSelectionne.DateCreation, StringFormat='{}{0:dd/MM/yyyy}'}"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock Classes="field-label" Text="Coût du cahier des charges" />
                                <TextBlock Text="{Binding CoutCahierAffiche}" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Spacing="2">
                                <TextBlock Classes="field-label" Text="Caution de soumission" />
                                <TextBlock Text="{Binding CautionAffichee}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <Border Grid.Column="0" Classes="stat">
                            <Grid ColumnDefinitions="4,*">
                                <Border Classes="stat-bar" />
                                <StackPanel Grid.Column="1" Spacing="2" Margin="16,14">
                                    <TextBlock Classes="kpi-label" Text="Candidats" />
                                    <TextBlock Classes="stat-value" Text="{Binding NombreCandidats}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Classes="stat">
                            <Grid ColumnDefinitions="4,*">
                                <Border Classes="stat-bar" />
                                <StackPanel Grid.Column="1" Spacing="2" Margin="16,14">
                                    <TextBlock Classes="kpi-label" Text="Acheteurs DAO" />
                                    <TextBlock Classes="stat-value" Text="{Binding NombreAcheteurs}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Classes="stat">
                            <Grid ColumnDefinitions="4,*">
                                <Border Classes="stat-bar" />
                                <StackPanel Grid.Column="1" Spacing="2" Margin="16,14">
                                    <TextBlock Classes="kpi-label" Text="Montant total des offres" />
                                    <TextBlock Classes="stat-value" Text="{Binding MontantTotalOffresAffiche}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Classes="card">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Classes="section-title"
                                       Text="Candidats et acheteurs" Margin="0,0,0,10" />

                            <TabControl>
                                <TabItem Header="Candidats">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                                    Spacing="8" Margin="0,10,0,10">
                                            <Button Content="Ajouter un candidat"
                                                    Command="{Binding AjouterCandidatCommand}"
                                                    IsEnabled="{Binding AUnDossier}" Classes="accent" />
                                            <Button Content="Désigner retenu"
                                                    Command="{Binding DesignerRetenuCommand}"
                                                    IsEnabled="{Binding AUnCandidat}" />
                                        </StackPanel>

                                        <Border DockPanel.Dock="Top" Classes="empty-state"
                                                IsVisible="{Binding !NombreCandidats}">
                                            <StackPanel Spacing="10" HorizontalAlignment="Center">
                                                <TextBlock Text="Ce dossier ne contient encore aucun candidat."
                                                           FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                <TextBlock Classes="muted" HorizontalAlignment="Center"
                                                           Text="Ajoutez les entreprises ayant déposé une offre." />
                                                <Button Content="Ajouter un candidat" Classes="accent"
                                                        HorizontalAlignment="Center"
                                                        Command="{Binding AjouterCandidatCommand}"
                                                        IsEnabled="{Binding AUnDossier}" />
                                            </StackPanel>
                                        </Border>

                                        <Border DockPanel.Dock="Bottom" Classes="total-band">
                                            <Grid ColumnDefinitions="*,160,88" ColumnSpacing="8">
                                                <TextBlock Grid.Column="0" Text="Total des offres" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding MontantTotalOffresAffiche}"
                                                           FontWeight="Bold" HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            </Grid>
                                        </Border>

                                        <Border DockPanel.Dock="Top" Classes="list-header">
                                            <Grid ColumnDefinitions="*,160,90,88" ColumnSpacing="8">
                                                <TextBlock Grid.Column="0" Text="Entreprise" />
                                                <TextBlock Grid.Column="1" Text="Montant de l'offre" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="2" Text="Statut" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="3" Text="Actions" HorizontalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <ListBox ItemsSource="{Binding Candidats}" SelectedItem="{Binding CandidatSelectionne}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="ent:Candidat">
                                                    <Grid ColumnDefinitions="*,160,90,88" ColumnSpacing="8"
                                                          MinHeight="48" VerticalAlignment="Center">
                                                        <TextBlock Grid.Column="0" Text="{Binding NomEntreprise}"
                                                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding MontantOffre, StringFormat='{}{0:N0} Ar'}"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        <Border Grid.Column="2" Classes="badge success"
                                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                IsVisible="{Binding EstRetenu}">
                                                            <TextBlock Text="Retenu" />
                                                        </Border>
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                    Spacing="4">
                                                            <Button Classes="icon row-action modify"
                                                                    ToolTip.Tip="Modifier le candidat"
                                                                    Command="{Binding $parent[UserControl].DataContext.ModifierCandidatCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <PathIcon Data="{x:Static vm:Icones.Modifier}"
                                                                          Width="18" Height="18" />
                                                            </Button>
                                                            <Button Classes="icon row-action delete"
                                                                    ToolTip.Tip="Supprimer le candidat"
                                                                    Command="{Binding $parent[UserControl].DataContext.SupprimerCandidatCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <PathIcon Data="{x:Static vm:Icones.Supprimer}"
                                                                          Width="18" Height="18" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </TabItem>

                                <TabItem Header="Acheteurs">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                                    Spacing="8" Margin="0,10,0,10">
                                            <Button Content="Ajouter un acheteur"
                                                    Command="{Binding AjouterAcheteurCommand}"
                                                    IsEnabled="{Binding AUnDossier}" Classes="accent" />
                                        </StackPanel>

                                        <Border DockPanel.Dock="Top" Classes="empty-state"
                                                IsVisible="{Binding !NombreAcheteurs}">
                                            <StackPanel Spacing="10" HorizontalAlignment="Center">
                                                <TextBlock Text="Ce dossier ne contient encore aucun acheteur."
                                                           FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                <TextBlock Classes="muted" HorizontalAlignment="Center"
                                                           Text="Ajoutez les entreprises ayant acheté le cahier des charges." />
                                                <Button Content="Ajouter un acheteur" Classes="accent"
                                                        HorizontalAlignment="Center"
                                                        Command="{Binding AjouterAcheteurCommand}"
                                                        IsEnabled="{Binding AUnDossier}" />
                                            </StackPanel>
                                        </Border>

                                        <Border DockPanel.Dock="Top" Classes="list-header">
                                            <Grid ColumnDefinitions="*,160,140,88" ColumnSpacing="8">
                                                <TextBlock Grid.Column="0" Text="Raison sociale" />
                                                <TextBlock Grid.Column="1" Text="N° stat." />
                                                <TextBlock Grid.Column="2" Text="Date d'achat" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="3" Text="Actions" HorizontalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <ListBox ItemsSource="{Binding Acheteurs}" SelectedItem="{Binding AcheteurSelectionne}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="ent:AcheteurDao">
                                                    <Grid ColumnDefinitions="*,160,140,88" ColumnSpacing="8"
                                                          MinHeight="48" VerticalAlignment="Center">
                                                        <TextBlock Grid.Column="0" Text="{Binding RaisonSociale}"
                                                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding NumStat}" Classes="muted"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding DateAchat, StringFormat='{}{0:dd/MM/yyyy}'}"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                    Spacing="4">
                                                            <Button Classes="icon row-action modify"
                                                                    ToolTip.Tip="Modifier l'acheteur"
                                                                    Command="{Binding $parent[UserControl].DataContext.ModifierAcheteurCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <PathIcon Data="{x:Static vm:Icones.Modifier}"
                                                                          Width="18" Height="18" />
                                                            </Button>
                                                            <Button Classes="icon row-action delete"
                                                                    ToolTip.Tip="Supprimer l'acheteur"
                                                                    Command="{Binding $parent[UserControl].DataContext.SupprimerAcheteurCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <PathIcon Data="{x:Static vm:Icones.Supprimer}"
                                                                          Width="18" Height="18" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </TabItem>
                            </TabControl>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
