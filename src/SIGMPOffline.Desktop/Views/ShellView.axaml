<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SIGMPOffline.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="720"
             x:Class="SIGMPOffline.Desktop.Views.ShellView"
             x:DataType="vm:ShellViewModel">

    <DockPanel>
        <!-- ============ Barre latérale ============ -->
        <Border DockPanel.Dock="Left" Width="264" Background="{DynamicResource SidebarBrush}">
            <DockPanel>

                <!-- En-tête / marque -->
                <Border DockPanel.Dock="Top" Padding="20,22,20,18">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="38" Height="38" CornerRadius="9" Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="S" FontSize="19" FontWeight="Bold"
                                       Foreground="{DynamicResource TextOnAccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SIGMP Offline" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SidebarTextActiveBrush}" />
                            <TextBlock Text="Suivi des Marchés Publics" FontSize="11"
                                       Foreground="{DynamicResource SidebarMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Pied de page -->
                <Border DockPanel.Dock="Bottom" Padding="16,12"
                        BorderBrush="{DynamicResource SidebarDividerBrush}" BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Version 1.0" FontSize="11"
                                       Foreground="{DynamicResource SidebarMutedBrush}" />
                            <TextBlock Text="100 % hors-ligne" FontSize="11"
                                       Foreground="{DynamicResource SidebarMutedBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="icon sidebar"
                                Command="{Binding BasculerThemeCommand}"
                                ToolTip.Tip="Changer de thème">
                            <Panel>
                                <!-- Soleil (thème clair actif) -->
                                <PathIcon Width="18" Height="18" IsVisible="{Binding !EstThemeSombre}"
                                          Data="M12 8 A4 4 0 1 0 12 16 A4 4 0 1 0 12 8 Z M11 1 H13 V4 H11 Z M11 20 H13 V23 H11 Z M1 11 H4 V13 H1 Z M20 11 H23 V13 H20 Z M4 5 H6 V7 H4 Z M18 5 H20 V7 H18 Z M4 17 H6 V19 H4 Z M18 17 H20 V19 H18 Z" />
                                <!-- Lune (thème sombre actif) -->
                                <PathIcon Width="18" Height="18" IsVisible="{Binding EstThemeSombre}"
                                          Data="M20.6 14.9 A9 9 0 1 1 9.1 3.4 A7 7 0 0 0 20.6 14.9 Z" />
                            </Panel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Navigation -->
                <ListBox Classes="nav"
                         ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedItem}"
                         Margin="10,2,10,10">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavigationItem">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="{Binding Icone}" Width="18" Height="18"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Titre}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============ Barre d'en-tête (propriétaire + province) ============ -->
        <Border DockPanel.Dock="Top" Height="60"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0" ColumnDefinitions="*,Auto">
                <!-- Province active -->
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <PathIcon Data="{x:Static vm:Icones.Province}" Width="18" Height="18"
                              Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="{Binding NomProvince}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Propriétaire + actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Border Classes="badge info" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="{Binding NomProprietaire}" />
                    </Border>

                    <Button Classes="icon" Command="{Binding NouvelleProvinceCommand}"
                            ToolTip.Tip="Nouvelle province">
                        <PathIcon Data="{x:Static vm:Icones.Ajouter}" Width="18" Height="18" />
                    </Button>
                    <Button Classes="icon" Command="{Binding ChangerMotDePasseCommand}"
                            ToolTip.Tip="Changer le mot de passe">
                        <PathIcon Data="{x:Static vm:Icones.Cadenas}" Width="18" Height="18" />
                    </Button>
                    <Button Classes="icon" Command="{Binding ChangerProvinceCommand}"
                            ToolTip.Tip="Changer de province">
                        <PathIcon Data="{x:Static vm:Icones.Echange}" Width="18" Height="18" />
                    </Button>
                    <Button Classes="icon" Command="{Binding SeDeconnecterCommand}"
                            ToolTip.Tip="Se déconnecter">
                        <PathIcon Data="{x:Static vm:Icones.Deconnexion}" Width="18" Height="18" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Contenu de la page courante ============ -->
        <Border Background="{DynamicResource AppBackgroundBrush}">
            <ContentControl Content="{Binding CurrentPage}" Margin="24" />
        </Border>
    </DockPanel>
</UserControl>
