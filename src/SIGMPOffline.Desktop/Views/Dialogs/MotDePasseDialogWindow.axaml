<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:SIGMPOffline.Desktop.ViewModels.Dialogs"
        xmlns:vm="using:SIGMPOffline.Desktop.ViewModels"
        xmlns:ctrl="using:SIGMPOffline.Desktop.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="470"
        x:Class="SIGMPOffline.Desktop.Views.Dialogs.MotDePasseDialogWindow"
        x:DataType="dlg:MotDePasseDialogViewModel"
        Title="{Binding Titre}"
        Width="520" SizeToContent="Height"
        Background="{DynamicResource AppBackgroundBrush}"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="24" Spacing="18">

        <!-- En-tête -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Classes="auth-dialog-icon">
                <PathIcon Data="{x:Static vm:Icones.Cadenas}"
                          Width="18" Height="18"
                          Foreground="{DynamicResource AccentBrush}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Classes="dialog-title" Text="{Binding Titre}" />
                <TextBlock Classes="auth-subtitle"
                            Text="Saisissez votre ancien mot de passe puis choisissez le nouveau." />
            </StackPanel>
        </Grid>

        <!-- Compte concerné -->
        <Border Classes="info">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <PathIcon Grid.Column="0"
                          Data="{x:Static vm:Icones.Province}"
                          Width="16" Height="16"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource InfoBrush}" />
                <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Classes="auth-caption" Text="Compte concerné" />
                    <TextBlock Classes="auth-meta" Text="{Binding NomUtilisateur}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Formulaire -->
        <StackPanel Spacing="14">

            <StackPanel Spacing="7">
                <TextBlock Classes="field-label">
                    Ancien mot de passe
                    <Run Foreground="{DynamicResource DangerBrush}">*</Run>
                </TextBlock>
                <ctrl:PasswordField Text="{Binding AncienMotDePasse, Mode=TwoWay}"
                                    PlaceholderText="Saisissez l'ancien mot de passe"
                                    NomAccessible="Ancien mot de passe"
                                    EstInvalide="{Binding AncienMotDePasseInvalide}" />
            </StackPanel>

            <StackPanel Spacing="7">
                <TextBlock Classes="field-label">
                    Nouveau mot de passe
                    <Run Foreground="{DynamicResource DangerBrush}">*</Run>
                </TextBlock>
                <ctrl:PasswordField Text="{Binding NouveauMotDePasse, Mode=TwoWay}"
                                    PlaceholderText="Saisissez le nouveau mot de passe"
                                    NomAccessible="Nouveau mot de passe"
                                    EstInvalide="{Binding NouveauMotDePasseInvalide}" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="auth-help"
                               Text="{Binding LongueurMinMotDePasse, StringFormat='{}{0} caractères minimum'}" />
                    <PathIcon Data="{x:Static vm:Icones.Validation}"
                              Width="12" Height="12"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource SuccessBrush}"
                              IsVisible="{Binding NouveauMotDePasseSuffisant}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="7">
                <TextBlock Classes="field-label" Text="Confirmation" />
                <ctrl:PasswordField Text="{Binding Confirmation, Mode=TwoWay}"
                                    PlaceholderText="Ressaisissez le nouveau mot de passe"
                                    NomAccessible="Confirmation du nouveau mot de passe"
                                    EstInvalide="{Binding ConfirmationInvalide}" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="auth-help" Text="Les mots de passe doivent être identiques" />
                    <PathIcon Data="{x:Static vm:Icones.Validation}"
                              Width="12" Height="12"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource SuccessBrush}"
                              IsVisible="{Binding MotsDePasseConcordent}" />
                </StackPanel>
            </StackPanel>

        </StackPanel>

        <!-- Message d'erreur -->
        <Border Classes="error"
                IsVisible="{Binding Erreur, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <PathIcon Grid.Column="0"
                          Data="{x:Static vm:Icones.Alerte}"
                          Width="15" Height="15"
                          VerticalAlignment="Top" Margin="0,1,0,0"
                          Foreground="{DynamicResource DangerBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding Erreur}" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Border Classes="divider" />

        <!-- Actions -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Annuler" Classes="ghost"
                    Command="{Binding AnnulerCommand}"
                    IsCancel="True" />
            <Button Content="Enregistrer" Classes="accent"
                    Command="{Binding ValiderCommand}"
                    IsDefault="True" />
        </StackPanel>

    </StackPanel>
</Window>
