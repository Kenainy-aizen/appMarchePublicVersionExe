<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:SIGMPOffline.Desktop.ViewModels.Dialogs"
        xmlns:vm="using:SIGMPOffline.Desktop.ViewModels"
        xmlns:ctrl="using:SIGMPOffline.Desktop.Controls"
        x:Class="SIGMPOffline.Desktop.Views.Dialogs.AccesVisiteurDialogWindow"
        x:DataType="dlg:AccesVisiteurDialogViewModel"
        Title="{Binding Titre}"
        Width="500" SizeToContent="Height"
        Background="{DynamicResource AppBackgroundBrush}"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="24" Spacing="16">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Classes="auth-dialog-icon">
                <PathIcon Data="{x:Static vm:Icones.Cadenas}"
                          Width="18" Height="18"
                          Foreground="{DynamicResource AccentBrush}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                <TextBlock Classes="dialog-title" Text="Accès visiteur" />
                <TextBlock Classes="auth-subtitle"
                           Text="Le compte visiteur ne peut que consulter les données de cette province." />
            </StackPanel>
        </Grid>

        <Border Classes="info">
            <StackPanel Spacing="2">
                <TextBlock Classes="auth-caption" Text="Province concernée" />
                <TextBlock Classes="auth-meta" Text="{Binding NomProvince}" />
            </StackPanel>
        </Border>

        <StackPanel Spacing="12" IsVisible="{Binding !DesactiverAcces}">
            <StackPanel Spacing="6">
                <TextBlock Classes="field-label" Text="Mot de passe visiteur" />
                <ctrl:PasswordField Text="{Binding NouveauMotDePasse, Mode=TwoWay}"
                                    PlaceholderText="4 caractères minimum"
                                    NomAccessible="Mot de passe visiteur"
                                    EstInvalide="{Binding MotDePasseInvalide}" />
                <TextBlock Classes="auth-help"
                           Text="Le compte est identifié comme « Visiteur » à l'écran de connexion." />
            </StackPanel>
            <StackPanel Spacing="6">
                <TextBlock Classes="field-label" Text="Confirmation" />
                <ctrl:PasswordField Text="{Binding Confirmation, Mode=TwoWay}"
                                    PlaceholderText="Ressaisissez le mot de passe"
                                    NomAccessible="Confirmation du mot de passe visiteur"
                                    EstInvalide="{Binding ConfirmationInvalide}" />
            </StackPanel>
        </StackPanel>

        <CheckBox IsVisible="{Binding AccesConfigure}"
                  IsChecked="{Binding DesactiverAcces}"
                  Content="Désactiver l'accès visiteur" />

        <Border Classes="error"
                IsVisible="{Binding Erreur, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding Erreur}" TextWrapping="Wrap" />
        </Border>

        <Border Classes="divider" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Annuler" Classes="ghost" Command="{Binding AnnulerCommand}" IsCancel="True" />
            <Button Content="Enregistrer" Classes="accent" Command="{Binding ValiderCommand}" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
