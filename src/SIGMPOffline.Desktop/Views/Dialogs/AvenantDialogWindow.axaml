<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:SIGMPOffline.Desktop.ViewModels.Dialogs"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="420"
        x:Class="SIGMPOffline.Desktop.Views.Dialogs.AvenantDialogWindow"
        x:DataType="dlg:AvenantDialogViewModel"
        Title="{Binding Titre}"
        Width="560" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="22" Spacing="16">
        <TextBlock Classes="dialog-title" Text="{Binding Titre}" />

        <Grid ColumnDefinitions="190,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
              RowSpacing="12" ColumnSpacing="12">
            <TextBlock Classes="field-label" Grid.Row="0" Grid.Column="0">Numéro de l'avenant <Run Foreground="{DynamicResource DangerBrush}">*</Run></TextBlock>
            <TextBox Grid.Row="0" Grid.Column="1"
                     Text="{Binding NumAvenant}"
                     PlaceholderText="ex. AV-001" />

            <TextBlock Classes="field-label" Grid.Row="1" Grid.Column="0">Date de l'avenant <Run Foreground="{DynamicResource DangerBrush}">*</Run></TextBlock>
            <DatePicker Grid.Row="1" Grid.Column="1"
                        SelectedDate="{Binding DateAvenant}"
                        HorizontalAlignment="Stretch" />

            <TextBlock Classes="field-label" Grid.Row="2" Grid.Column="0">Motif</TextBlock>
            <TextBox Grid.Row="2" Grid.Column="1"
                     Text="{Binding Motif}"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" />

            <TextBlock Classes="field-label" Grid.Row="3" Grid.Column="0">Variation du montant (Ar)</TextBlock>
            <NumericUpDown Grid.Row="3" Grid.Column="1"
                           Value="{Binding VariationMontant}"
                           FormatString="N0" ShowButtonSpinner="False" />

            <TextBlock Classes="field-label" Grid.Row="4" Grid.Column="0">Prolongation du délai (jours)</TextBlock>
            <NumericUpDown Grid.Row="4" Grid.Column="1"
                           Value="{Binding ProlongationJours}"
                           FormatString="N0" ShowButtonSpinner="False" />
        </Grid>

        <Border Classes="error" IsVisible="{Binding Erreur, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding Erreur}" TextWrapping="Wrap" />
        </Border>

        <Border Classes="divider" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Annuler" Command="{Binding AnnulerCommand}" Classes="ghost" />
            <Button Content="Enregistrer" Command="{Binding ValiderCommand}" Classes="accent" />
        </StackPanel>
    </StackPanel>
</Window>
