<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:SIGMPOffline.Desktop.ViewModels.Dialogs"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="420"
        x:Class="SIGMPOffline.Desktop.Views.Dialogs.AvenantDialogWindow"
        x:DataType="dlg:AvenantDialogViewModel"
        Title="{Binding Titre}"
        Width="560" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20" Spacing="16">
        <TextBlock Text="{Binding Titre}" FontSize="16" FontWeight="SemiBold" />

        <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
              RowSpacing="10" ColumnSpacing="10">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Numéro de l'avenant *" VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="1"
                     Text="{Binding NumAvenant}"
                     PlaceholderText="ex. AV-001" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Date de l'avenant *" VerticalAlignment="Center" />
            <DatePicker Grid.Row="1" Grid.Column="1"
                        SelectedDate="{Binding DateAvenant}"
                        HorizontalAlignment="Stretch" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Motif" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1"
                     Text="{Binding Motif}"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Variation du montant (FCFA)" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="3" Grid.Column="1"
                           Value="{Binding VariationMontant}"
                           FormatString="N0" ShowButtonSpinner="False" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Prolongation du délai (jours)" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="4" Grid.Column="1"
                           Value="{Binding ProlongationJours}"
                           FormatString="N0" ShowButtonSpinner="False" />
        </Grid>

        <Border Classes="error" IsVisible="{Binding Erreur, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding Erreur}" Foreground="#B91C1C" TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Annuler" Command="{Binding AnnulerCommand}" />
            <Button Content="Enregistrer" Command="{Binding ValiderCommand}" Classes="accent" />
        </StackPanel>
    </StackPanel>
</Window>
