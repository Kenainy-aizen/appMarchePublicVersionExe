<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:SIGMPOffline.Desktop.ViewModels.Dialogs"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="580" d:DesignHeight="460"
        x:Class="SIGMPOffline.Desktop.Views.Dialogs.MarcheDialogWindow"
        x:DataType="dlg:MarcheDialogViewModel"
        Title="{Binding Titre}"
        Width="580" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20" Spacing="16">
        <TextBlock Text="{Binding Titre}" FontSize="16" FontWeight="SemiBold" />

        <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
              RowSpacing="10" ColumnSpacing="10">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Référence du marché *" VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="1"
                     Text="{Binding RefMarche}"
                     IsEnabled="{Binding RefMarcheModifiable}"
                     PlaceholderText="ex. M-2026-001" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Dossier DAO *" VerticalAlignment="Center" />
            <ComboBox Grid.Row="1" Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      IsEnabled="{Binding DossierModifiable}"
                      ItemsSource="{Binding Dossiers}"
                      SelectedItem="{Binding DossierSelectionne}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Titulaire (attributaire)" VerticalAlignment="Center" />
            <ComboBox Grid.Row="2" Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Candidats}"
                      SelectedItem="{Binding TitulaireSelectionne}" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Objet du marché *" VerticalAlignment="Center" />
            <TextBox Grid.Row="3" Grid.Column="1"
                     Text="{Binding ObjetMarche}"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Montant HT (FCFA)" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="4" Grid.Column="1"
                           Value="{Binding MontantHT}"
                           Minimum="0" FormatString="N0" ShowButtonSpinner="False" />

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Montant TTC (FCFA)" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="5" Grid.Column="1"
                           Value="{Binding MontantTTC}"
                           Minimum="0" FormatString="N0" ShowButtonSpinner="False" />

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Délai d'exécution (jours)" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="6" Grid.Column="1"
                           Value="{Binding DelaiExecutionJours}"
                           Minimum="0" FormatString="N0" ShowButtonSpinner="False" />
        </Grid>

        <Border Classes="error" IsVisible="{Binding Erreur, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding Erreur}" Foreground="#B91C1C" TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Annuler" Command="{Binding AnnulerCommand}" />
            <Button Content="Enregistrer" Command="{Binding ValiderCommand}" Classes="accent" />
        </StackPanel>
    </StackPanel>
</Window>
