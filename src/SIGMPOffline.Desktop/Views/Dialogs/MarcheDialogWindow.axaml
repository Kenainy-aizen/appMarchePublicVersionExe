<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:SIGMPOffline.Desktop.ViewModels.Dialogs"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="580" d:DesignHeight="460"
        x:Class="SIGMPOffline.Desktop.Views.Dialogs.MarcheDialogWindow"
        x:DataType="dlg:MarcheDialogViewModel"
        Title="{Binding Titre}"
        Width="580" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="22" Spacing="16">
        <TextBlock Classes="dialog-title" Text="{Binding Titre}" />

        <Grid ColumnDefinitions="190,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
              RowSpacing="12" ColumnSpacing="12">
            <TextBlock Classes="field-label" Grid.Row="0" Grid.Column="0">Référence du marché <Run Foreground="{DynamicResource DangerBrush}">*</Run></TextBlock>
            <TextBox Grid.Row="0" Grid.Column="1"
                     Text="{Binding RefMarche}"
                     IsEnabled="{Binding RefMarcheModifiable}"
                     PlaceholderText="ex. M-2026-001" />

            <TextBlock Classes="field-label" Grid.Row="1" Grid.Column="0">Dossier DAO <Run Foreground="{DynamicResource DangerBrush}">*</Run></TextBlock>
            <ComboBox Grid.Row="1" Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      IsEnabled="{Binding DossierModifiable}"
                      ItemsSource="{Binding Dossiers}"
                      SelectedItem="{Binding DossierSelectionne}" />

            <TextBlock Classes="field-label" Grid.Row="2" Grid.Column="0">Titulaire (attributaire)</TextBlock>
            <ComboBox Grid.Row="2" Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Titulaires}"
                      SelectedItem="{Binding TitulaireSelectionne}" />

            <TextBlock Classes="field-label" Grid.Row="3" Grid.Column="0">Objet du marché <Run Foreground="{DynamicResource DangerBrush}">*</Run></TextBlock>
            <TextBox Grid.Row="3" Grid.Column="1"
                     Text="{Binding ObjetMarche}"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" />

            <TextBlock Classes="field-label" Grid.Row="4" Grid.Column="0">Montant HT (Ar)</TextBlock>
            <NumericUpDown Grid.Row="4" Grid.Column="1"
                           Value="{Binding MontantHT}"
                           Minimum="0" FormatString="N0" ShowButtonSpinner="False" />

            <TextBlock Classes="field-label" Grid.Row="5" Grid.Column="0">Montant TTC (Ar)</TextBlock>
            <NumericUpDown Grid.Row="5" Grid.Column="1"
                           Value="{Binding MontantTTC}"
                           Minimum="0" FormatString="N0" ShowButtonSpinner="False" />

            <TextBlock Classes="field-label" Grid.Row="6" Grid.Column="0">Délai d'exécution (jours)</TextBlock>
            <NumericUpDown Grid.Row="6" Grid.Column="1"
                           Value="{Binding DelaiExecutionJours}"
                           Minimum="0" FormatString="N0" ShowButtonSpinner="False" />
        </Grid>

        <Border Classes="error" IsVisible="{Binding Erreur, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding Erreur}" TextWrapping="Wrap" />
        </Border>

        <Border Classes="divider" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Annuler" Command="{Binding AnnulerCommand}" Classes="ghost" />
            <Button Content="Enregistrer" Command="{Binding ValiderCommand}" Classes="accent" />
        </StackPanel>
    </StackPanel>
</Window>
