<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:SIGMPOffline.Desktop.ViewModels.Dialogs"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="360"
        x:Class="SIGMPOffline.Desktop.Views.Dialogs.PpmDetailDialogWindow"
        x:DataType="dlg:PpmDetailDialogViewModel"
        Title="{Binding Titre}"
        Width="520" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="22" Spacing="16">
        <TextBlock Classes="dialog-title" Text="{Binding Titre}" />

        <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
              RowSpacing="12" ColumnSpacing="12">
            <TextBlock Classes="field-label" Grid.Row="0" Grid.Column="0">N° de la ligne <Run Foreground="{DynamicResource DangerBrush}">*</Run></TextBlock>
            <TextBox Grid.Row="0" Grid.Column="1"
                     Text="{Binding NumPPMDetail}"
                     IsEnabled="{Binding NumDetailModifiable}"
                     PlaceholderText="ex. 2026-004" />

            <TextBlock Classes="field-label" Grid.Row="1" Grid.Column="0">Objet du projet <Run Foreground="{DynamicResource DangerBrush}">*</Run></TextBlock>
            <TextBox Grid.Row="1" Grid.Column="1"
                     Text="{Binding ObjetProjet}"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />

            <TextBlock Classes="field-label" Grid.Row="2" Grid.Column="0">Nature du marché</TextBlock>
            <ComboBox Grid.Row="2" Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Natures}"
                      SelectedItem="{Binding NatureSelectionnee}" />

            <TextBlock Classes="field-label" Grid.Row="3" Grid.Column="0">Mode de passation</TextBlock>
            <ComboBox Grid.Row="3" Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Modes}"
                      SelectedItem="{Binding ModeSelectionne}" />

            <TextBlock Classes="field-label" Grid.Row="4" Grid.Column="0">Montant estimatif (Ar)</TextBlock>
            <NumericUpDown Grid.Row="4" Grid.Column="1"
                           Value="{Binding MontantEstimatif}"
                           Minimum="0" FormatString="N0" ShowButtonSpinner="False" />

            <TextBlock Classes="field-label" Grid.Row="5" Grid.Column="0">Source de financement</TextBlock>
            <TextBox Grid.Row="5" Grid.Column="1"
                     Text="{Binding SourceFinancement}"
                     PlaceholderText="Budget national, bailleur…" />
        </Grid>

        <Border Classes="error" IsVisible="{Binding Erreur, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding Erreur}" TextWrapping="Wrap" />
        </Border>

        <Border Classes="divider" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Annuler" Command="{Binding AnnulerCommand}" Classes="ghost" />
            <Button Content="Enregistrer" Command="{Binding ValiderCommand}" Classes="accent" />
        </StackPanel>
    </StackPanel>
</Window>
