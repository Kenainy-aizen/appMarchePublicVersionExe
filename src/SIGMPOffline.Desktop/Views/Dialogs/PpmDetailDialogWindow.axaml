<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:SIGMPOffline.Desktop.ViewModels.Dialogs"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="340"
        x:Class="SIGMPOffline.Desktop.Views.Dialogs.PpmDetailDialogWindow"
        x:DataType="dlg:PpmDetailDialogViewModel"
        Title="{Binding Titre}"
        Width="520" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20" Spacing="16">
        <TextBlock Text="{Binding Titre}" FontSize="16" FontWeight="SemiBold" />

        <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
              RowSpacing="10" ColumnSpacing="10">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="N° de la ligne *" VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="1"
                     Text="{Binding NumPPMDetail}"
                     IsEnabled="{Binding NumDetailModifiable}"
                     PlaceholderText="ex. 2026-004" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Objet du projet *" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1"
                     Text="{Binding ObjetProjet}"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Nature du marché" VerticalAlignment="Center" />
            <ComboBox Grid.Row="2" Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Natures}"
                      SelectedItem="{Binding NatureSelectionnee}" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Mode de passation" VerticalAlignment="Center" />
            <ComboBox Grid.Row="3" Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Modes}"
                      SelectedItem="{Binding ModeSelectionne}" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Montant estimatif (FCFA)" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="4" Grid.Column="1"
                           Value="{Binding MontantEstimatif}"
                           Minimum="0" FormatString="N0" ShowButtonSpinner="False" />

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Source de financement" VerticalAlignment="Center" />
            <TextBox Grid.Row="5" Grid.Column="1"
                     Text="{Binding SourceFinancement}"
                     PlaceholderText="Budget national, bailleur…" />
        </Grid>

        <Border Classes="error" IsVisible="{Binding Erreur, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding Erreur}" Foreground="#B91C1C" TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Annuler" Command="{Binding AnnulerCommand}" />
            <Button Content="Enregistrer" Command="{Binding ValiderCommand}" Classes="accent" />
        </StackPanel>
    </StackPanel>
</Window>
