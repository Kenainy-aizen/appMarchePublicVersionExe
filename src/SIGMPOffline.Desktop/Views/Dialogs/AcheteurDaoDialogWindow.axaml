<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:SIGMPOffline.Desktop.ViewModels.Dialogs"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="340"
        x:Class="SIGMPOffline.Desktop.Views.Dialogs.AcheteurDaoDialogWindow"
        x:DataType="dlg:AcheteurDaoDialogViewModel"
        Title="{Binding Titre}"
        Width="520" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="22" Spacing="16">
        <TextBlock Classes="dialog-title" Text="{Binding Titre}" />

        <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
              RowSpacing="12" ColumnSpacing="12">
            <TextBlock Classes="field-label" Grid.Row="0" Grid.Column="0">Raison sociale <Run Foreground="{DynamicResource DangerBrush}">*</Run></TextBlock>
            <TextBox Grid.Row="0" Grid.Column="1"
                     Text="{Binding RaisonSociale}"
                     PlaceholderText="ex. Établissement BTP" />

            <TextBlock Classes="field-label" Grid.Row="1" Grid.Column="0">N° statistique</TextBlock>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NumStat}"
                     IsEnabled="{Binding NumStatModifiable}" />

            <TextBlock Classes="field-label" Grid.Row="2" Grid.Column="0">N° NIF</TextBlock>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding NumNIF}" />

            <TextBlock Classes="field-label" Grid.Row="3" Grid.Column="0">Adresse</TextBlock>
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Adresse}" />

            <TextBlock Classes="field-label" Grid.Row="4" Grid.Column="0">Date d'achat</TextBlock>
            <DatePicker Grid.Row="4" Grid.Column="1" SelectedDate="{Binding DateAchat}"
                        HorizontalAlignment="Stretch" />
        </Grid>

        <Border Classes="error" IsVisible="{Binding Erreur, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding Erreur}" TextWrapping="Wrap" />
        </Border>

        <Border Classes="divider" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Annuler" Command="{Binding AnnulerCommand}" Classes="ghost" />
            <Button Content="Enregistrer" Command="{Binding ValiderCommand}" Classes="accent" />
        </StackPanel>
    </StackPanel>
</Window>
