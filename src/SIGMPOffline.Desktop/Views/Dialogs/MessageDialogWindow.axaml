<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:SIGMPOffline.Desktop.ViewModels.Dialogs"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="200"
        x:Class="SIGMPOffline.Desktop.Views.Dialogs.MessageDialogWindow"
        x:DataType="dlg:MessageDialogViewModel"
        Title="{Binding Titre}"
        Width="460" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="22" Spacing="16">
        <TextBlock Classes="dialog-title" Text="{Binding Titre}" />
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />

        <Border Classes="divider" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Annuler"
                    Command="{Binding AnnulerCommand}"
                    Classes="ghost"
                    IsVisible="{Binding AfficherAnnuler}" />
            <Button Content="{Binding LibelleValider}"
                    Command="{Binding ValiderCommand}"
                    Classes="accent" />
        </StackPanel>
    </StackPanel>
</Window>
