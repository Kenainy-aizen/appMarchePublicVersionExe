<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:SIGMPOffline.Desktop.ViewModels.Dialogs"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="540" d:DesignHeight="360"
        x:Class="SIGMPOffline.Desktop.Views.Dialogs.DossierDaoDialogWindow"
        x:DataType="dlg:DossierDaoDialogViewModel"
        Title="{Binding Titre}"
        Width="540" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="22" Spacing="16">
        <TextBlock Classes="dialog-title" Text="{Binding Titre}" />

        <Grid ColumnDefinitions="190,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
              RowSpacing="12" ColumnSpacing="12">
            <TextBlock Classes="field-label" Grid.Row="0" Grid.Column="0">Référence du dossier <Run Foreground="{DynamicResource DangerBrush}">*</Run></TextBlock>
            <TextBox Grid.Row="0" Grid.Column="1"
                     Text="{Binding RefDossier}"
                     IsEnabled="{Binding RefDossierModifiable}"
                     PlaceholderText="ex. DAO-2026-001" />

            <TextBlock Classes="field-label" Grid.Row="1" Grid.Column="0">Ligne du PPM <Run Foreground="{DynamicResource DangerBrush}">*</Run></TextBlock>
            <ComboBox Grid.Row="1" Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Lignes}"
                      SelectedItem="{Binding LigneSelectionnee}" />

            <TextBlock Classes="field-label" Grid.Row="2" Grid.Column="0">Objet du dossier <Run Foreground="{DynamicResource DangerBrush}">*</Run></TextBlock>
            <TextBox Grid.Row="2" Grid.Column="1"
                     Text="{Binding ObjetDossier}"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" />

            <TextBlock Classes="field-label" Grid.Row="3" Grid.Column="0">Coût du cahier des charges (Ar)</TextBlock>
            <NumericUpDown Grid.Row="3" Grid.Column="1"
                           Value="{Binding CoutCahierCharges}"
                           Minimum="0" FormatString="N0" ShowButtonSpinner="False" />

            <TextBlock Classes="field-label" Grid.Row="4" Grid.Column="0">Montant de la caution (Ar)</TextBlock>
            <NumericUpDown Grid.Row="4" Grid.Column="1"
                           Value="{Binding MontantCaution}"
                           Minimum="0" FormatString="N0" ShowButtonSpinner="False" />
        </Grid>

        <Border Classes="error" IsVisible="{Binding Erreur, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding Erreur}" TextWrapping="Wrap" />
        </Border>

        <Border Classes="divider" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Annuler" Command="{Binding AnnulerCommand}" Classes="ghost" />
            <Button Content="Enregistrer" Command="{Binding ValiderCommand}" Classes="accent" />
        </StackPanel>
    </StackPanel>
</Window>
