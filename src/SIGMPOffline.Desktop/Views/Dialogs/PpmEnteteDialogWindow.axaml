<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="using:SIGMPOffline.Desktop.ViewModels.Dialogs"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="300"
        x:Class="SIGMPOffline.Desktop.Views.Dialogs.PpmEnteteDialogWindow"
        x:DataType="dlg:PpmEnteteDialogViewModel"
        Title="{Binding Titre}"
        Width="500" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="22" Spacing="16">
        <TextBlock Classes="dialog-title" Text="{Binding Titre}" />

        <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto"
              RowSpacing="12" ColumnSpacing="12">
            <TextBlock Classes="field-label" Grid.Row="0" Grid.Column="0">Numéro du PPM <Run Foreground="{DynamicResource DangerBrush}">*</Run></TextBlock>
            <TextBox Grid.Row="0" Grid.Column="1"
                     Text="{Binding NumPPM}"
                     IsEnabled="{Binding NumPpmModifiable}"
                     PlaceholderText="ex. PPM-2026" />

            <TextBlock Classes="field-label" Grid.Row="1" Grid.Column="0">Exercice budgétaire <Run Foreground="{DynamicResource DangerBrush}">*</Run></TextBlock>
            <NumericUpDown Grid.Row="1" Grid.Column="1"
                           Value="{Binding AnneeExercice}"
                           Minimum="2000" Maximum="2100"
                           FormatString="N0" ShowButtonSpinner="False" />

            <TextBlock Classes="field-label" Grid.Row="2" Grid.Column="0">Autorité contractante <Run Foreground="{DynamicResource DangerBrush}">*</Run></TextBlock>
            <TextBox Grid.Row="2" Grid.Column="1"
                     Text="{Binding AutoriteContractante}"
                     PlaceholderText="PRMP - Ministère…" />

            <TextBlock Classes="field-label" Grid.Row="3" Grid.Column="0">Date d'élaboration</TextBlock>
            <DatePicker Grid.Row="3" Grid.Column="1" SelectedDate="{Binding DateElaboration}"
                        HorizontalAlignment="Stretch" />
        </Grid>

        <Border Classes="error" IsVisible="{Binding Erreur, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding Erreur}" TextWrapping="Wrap" />
        </Border>

        <Border Classes="divider" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Annuler" Command="{Binding AnnulerCommand}" Classes="ghost" />
            <Button Content="Enregistrer" Command="{Binding ValiderCommand}" Classes="accent" />
        </StackPanel>
    </StackPanel>
</Window>
