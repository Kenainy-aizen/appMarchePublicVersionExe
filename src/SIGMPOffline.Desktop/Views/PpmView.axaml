<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SIGMPOffline.Desktop.ViewModels"
             xmlns:ent="using:SIGMPOffline.Domain.Entities"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="SIGMPOffline.Desktop.Views.PpmView"
             x:DataType="vm:PpmViewModel">

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14">

        <!-- En-tête + barre d'actions -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
                <TextBlock Classes="page-title" Text="Plan de Passation des Marchés" />
                <TextBlock Classes="page-subtitle" Text="Plans annuels et lignes de passation." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button Content="Nouveau PPM" Command="{Binding NouveauPpmCommand}" Classes="accent" />
                <Button Content="Modifier" Command="{Binding ModifierPpmCommand}" IsEnabled="{Binding AUnEntete}" />
                <Button Content="Supprimer" Command="{Binding SupprimerPpmCommand}" IsEnabled="{Binding AUnEntete}" Classes="danger" />
                <Button Content="Actualiser" Command="{Binding ChargerCommand}" Classes="ghost" />
            </StackPanel>
        </Grid>

        <!-- Messages -->
        <StackPanel Grid.Row="1" Spacing="8">
            <Border Classes="error"
                    IsVisible="{Binding Erreur, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding Erreur}" TextWrapping="Wrap" />
            </Border>
            <Border Classes="success"
                    IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="320,*" ColumnSpacing="14">

            <!-- Liste des PPM -->
            <Border Classes="card">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="section-title" Text="Plans (PPM)" Margin="0,0,0,10" />
                    <ListBox ItemsSource="{Binding Entetes}" SelectedItem="{Binding EnteteSelectionne}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="ent:PpmEntete">
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding NumPPM}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding AnneeExercice, StringFormat='Exercice {0}'}"
                                               Classes="muted" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Détails du PPM sélectionné -->
            <Border Grid.Column="1" Classes="card">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,12">
                        <TextBlock Classes="section-title" Text="Lignes de détail" />
                        <TextBlock Classes="muted" Text="{Binding EnteteSelectionne.AutoriteContractante}" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                        <Button Content="Ajouter une ligne" Command="{Binding AjouterDetailCommand}"
                                IsEnabled="{Binding AUnEntete}" Classes="accent" />
                        <Button Content="Modifier" Command="{Binding ModifierDetailCommand}"
                                IsEnabled="{Binding AUnDetail}" />
                        <Button Content="Supprimer" Command="{Binding SupprimerDetailCommand}"
                                IsEnabled="{Binding AUnDetail}" Classes="danger" />
                    </StackPanel>

                    <Border DockPanel.Dock="Top" Classes="list-header">
                        <Grid ColumnDefinitions="110,*,150,170">
                            <TextBlock Grid.Column="0" Text="N°" />
                            <TextBlock Grid.Column="1" Text="Objet" />
                            <TextBlock Grid.Column="2" Text="Nature" />
                            <TextBlock Grid.Column="3" Text="Montant estimatif" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <ListBox ItemsSource="{Binding Details}" SelectedItem="{Binding DetailSelectionne}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="ent:PpmDetail">
                                <Grid ColumnDefinitions="110,*,150,170">
                                    <TextBlock Grid.Column="0" Text="{Binding NumPPMDetail}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding ObjetProjet}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding NatureMarche, Converter={StaticResource EnumLibelle}}"
                                               Classes="muted" />
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding MontantEstimatif, StringFormat='{}{0:N0} Ar'}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
