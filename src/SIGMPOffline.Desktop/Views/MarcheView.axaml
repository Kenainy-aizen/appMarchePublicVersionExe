<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SIGMPOffline.Desktop.ViewModels"
             xmlns:ent="using:SIGMPOffline.Domain.Entities"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="640"
             x:Class="SIGMPOffline.Desktop.Views.MarcheView"
             x:DataType="vm:MarcheViewModel">

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <!-- Barre d'actions -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Classes="page-title" Text="Marchés &amp; Bordereaux" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Nouveau marché" Command="{Binding NouveauMarcheCommand}" Classes="accent" />
                <Button Content="Modifier" Command="{Binding ModifierMarcheCommand}" IsEnabled="{Binding AUnMarche}" />
                <Button Content="Supprimer" Command="{Binding SupprimerMarcheCommand}" IsEnabled="{Binding AUnMarche}" />
                <Button Content="Actualiser" Command="{Binding ChargerCommand}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="8">
            <Border Classes="error" IsVisible="{Binding Erreur, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding Erreur}" Foreground="#B91C1C" TextWrapping="Wrap" />
            </Border>
            <Border Classes="success" IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding Message}" Foreground="#15803D" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="340,*" ColumnSpacing="12">
            <!-- Liste des marchés -->
            <Border Classes="card">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="section-title" Text="Marchés" />
                    <ListBox ItemsSource="{Binding Marches}"
                             SelectedItem="{Binding MarcheSelectionne}"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="ent:Marche">
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding RefMarche}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ObjetMarche}" Foreground="#64748B"
                                               FontSize="12" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding MontantTTC, StringFormat='{}{0:N0} FCFA TTC'}"
                                               Foreground="#334155" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Bordereau du marché sélectionné -->
            <Border Grid.Column="1" Classes="card">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
                        <TextBlock Classes="section-title" Text="{Binding MarcheSelectionne.RefMarche}" />
                        <TextBlock Text="{Binding MarcheSelectionne.ObjetMarche}" Foreground="#64748B"
                                   TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,*,*" Margin="0,4,0,0">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding MarcheSelectionne.MontantHT, StringFormat='HT : {0:N0} FCFA'}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding MarcheSelectionne.MontantTTC, StringFormat='TTC : {0:N0} FCFA'}" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding MarcheSelectionne.DelaiExecutionJours, StringFormat='Délai : {0} j'}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8"
                                IsEnabled="{Binding AUnMarche}">
                        <Button Content="Ajouter un élément" Command="{Binding AjouterElementCommand}" Classes="accent" />
                        <Button Content="Modifier" Command="{Binding ModifierElementCommand}" IsEnabled="{Binding AUnElement}" />
                        <Button Content="Supprimer" Command="{Binding SupprimerElementCommand}" IsEnabled="{Binding AUnElement}" />
                        <Button Content="Recalculer les montants" Command="{Binding RecalculerMontantsCommand}" />
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Elements}"
                             SelectedItem="{Binding ElementSelectionne}"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="ent:ElementMarche">
                                <Grid ColumnDefinitions="90,*,120,90,80,140" Margin="0,4">
                                    <TextBlock Grid.Column="0" Text="{Binding CodeElement}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding Libelle}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding PrixUnitaire, StringFormat='{}{0:N0} FCFA'}"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="{Binding Quantite, StringFormat='x {0:N2}'}"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="{Binding Unite}" Foreground="#64748B" />
                                    <TextBlock Grid.Column="5"
                                               Text="{Binding MontantLigne, StringFormat='{}{0:N0} FCFA'}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
