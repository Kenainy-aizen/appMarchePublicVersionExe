<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SIGMPOffline.Desktop.ViewModels"
             xmlns:ent="using:SIGMPOffline.Domain.Entities"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1366" d:DesignHeight="760"
             x:Class="SIGMPOffline.Desktop.Views.MarcheView"
             x:DataType="vm:MarcheViewModel">

    <!--
        Module Marchés en deux écrans (même page), sur le modèle des modules PPM et DAO :
          1. LISTE des marchés       -> visible quand EstEnVueDetail = false ;
          2. DÉTAIL d'un marché      -> visible après « Ouvrir » (EstEnVueDetail = true).
    -->
    <UserControl.Styles>
        <Style Selector="Border.stat">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.stat-bar">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="TextBlock.stat-value">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="TextBlock.marche-number">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Border.total-band">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
            <Setter Property="Padding" Value="10,10" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style Selector="Border.empty-state">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusPanel}" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" RowSpacing="12">

        <!-- ============ Messages (communs aux deux écrans) ============ -->
        <StackPanel Grid.Row="0" Spacing="8">
            <Border Classes="error"
                    IsVisible="{Binding Erreur, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding Erreur}" TextWrapping="Wrap" />
            </Border>
            <Border Classes="success"
                    IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- =====================================================================
             ÉCRAN 1 : LISTE DES MARCHÉS
             ===================================================================== -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="14"
              IsVisible="{Binding !EstEnVueDetail}">

            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                    <TextBlock Classes="page-title" Text="Marchés &amp; Bordereaux" />
                    <TextBlock Classes="page-subtitle"
                               Text="Un marché par dossier DAO. Cliquez sur « Ouvrir » pour gérer son bordereau." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <Button Content="Actualiser"
                            Command="{Binding ChargerCommand}" Classes="ghost"
                            IsEnabled="{Binding !EstOccupe}" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="14" Margin="0,0,12,0">

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <Border Grid.Column="0" Classes="stat">
                            <Grid ColumnDefinitions="4,*">
                                <Border Classes="stat-bar" />
                                <StackPanel Grid.Column="1" Spacing="2" Margin="16,14">
                                    <TextBlock Classes="kpi-label" Text="Marchés formalisés" />
                                    <TextBlock Classes="stat-value" Text="{Binding NombreMarches}" />
                                    <TextBlock Classes="legende" Text="dans cette province" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Classes="stat">
                            <Grid ColumnDefinitions="4,*">
                                <Border Classes="stat-bar" />
                                <StackPanel Grid.Column="1" Spacing="2" Margin="16,14">
                                    <TextBlock Classes="kpi-label" Text="Montant TTC total" />
                                    <TextBlock Classes="stat-value" Text="{Binding MontantTtcTotalAffiche}" />
                                    <TextBlock Classes="legende" Text="tous marchés confondus" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Classes="stat">
                            <Grid ColumnDefinitions="4,*">
                                <Border Classes="stat-bar" />
                                <StackPanel Grid.Column="1" Spacing="2" Margin="16,14">
                                    <TextBlock Classes="kpi-label" Text="Éléments du bordereau" />
                                    <TextBlock Classes="stat-value" Text="{Binding NombreElementsTousMarches}" />
                                    <TextBlock Classes="legende" Text="tous marchés confondus" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Classes="panel">
                        <Grid ColumnDefinitions="2*,*,Auto" ColumnSpacing="10">
                            <TextBox PlaceholderText="Rechercher par référence, objet ou dossier DAO…" Text="{Binding RechercheMarche, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding StatutsMarchesDisponibles}" SelectedItem="{Binding FiltreStatutMarche}" />
                            <Button Grid.Column="2" Content="Réinitialiser" Classes="ghost" Command="{Binding ReinitialiserFiltresCommand}" />
                        </Grid>
                    </Border>
                    <Border Classes="card">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                <TextBlock Classes="section-title" Text="Liste des marchés"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Nouveau marché"
                                        Command="{Binding NouveauMarcheCommand}" Classes="accent"
                                        IsEnabled="{Binding PeutAgir}" />
                            </Grid>

                            <Border DockPanel.Dock="Top" Classes="empty-state"
                                    IsVisible="{Binding !NombreMarches}">
                                <StackPanel Spacing="10" HorizontalAlignment="Center">
                                    <PathIcon Data="{x:Static vm:Icones.Marche}" Width="28" Height="28"
                                              Foreground="{DynamicResource AccentBrush}"
                                              HorizontalAlignment="Center" />
                                    <TextBlock Text="Aucun marché formalisé pour cette province."
                                               FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Classes="muted" HorizontalAlignment="Center"
                                               Text="Créez un marché à partir d'un dossier DAO." />
                                </StackPanel>
                            </Border>

                            <Border DockPanel.Dock="Top" Classes="list-header">
                                <Grid ColumnDefinitions="110,*,140,90,110,128" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Text="Réf. marché" />
                                    <TextBlock Grid.Column="1" Text="Objet, dossier et titulaire" />
                                    <TextBlock Grid.Column="2" Text="Montant TTC" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="Délai" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="Statut" />
                                    <TextBlock Grid.Column="5" Text="Actions" HorizontalAlignment="Center" />
                                </Grid>
                            </Border>

                            <ListBox ItemsSource="{Binding MarchesFiltres}" SelectedItem="{Binding MarcheSelectionne}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="ent:Marche">
                                        <Grid ColumnDefinitions="110,*,140,90,110,128" ColumnSpacing="8"
                                              MinHeight="64" VerticalAlignment="Center">
                                            <TextBlock Grid.Column="0" Classes="marche-number"
                                                       Text="{Binding RefMarche}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ObjetMarche}" TextWrapping="Wrap"
                                                           FontWeight="Medium" />
                                                <TextBlock Classes="legende" TextWrapping="Wrap">
                                                    <TextBlock.Text>
                                                        <Binding Path="Dossier.RefDossier" StringFormat="Dossier DAO : {0}" TargetNullValue="Dossier DAO : —" />
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock Classes="legende" TextWrapping="Wrap">
                                                    <TextBlock.Text>
                                                        <Binding Path="Titulaire.RaisonSociale" StringFormat="Titulaire : {0}" TargetNullValue="Titulaire : —" />
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" FontWeight="SemiBold"
                                                       Text="{Binding MontantTTC, StringFormat='{}{0:N0} Ar'}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding DelaiExecutionJours, StringFormat='{}{0} j'}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Classes="muted" TextWrapping="Wrap"
                                                       Text="{Binding StatutExecution, Converter={StaticResource EnumLibelle}}"
                                                       VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Classes="icon row-action modify"
                                                        ToolTip.Tip="Ouvrir ce marché (bordereau)"
                                                        Command="{Binding $parent[UserControl].DataContext.OuvrirMarcheCommand}"
                                                        CommandParameter="{Binding}">
                                                    <PathIcon Data="{x:Static vm:Icones.Marche}" Width="18" Height="18" />
                                                </Button>
                                                <Button Classes="icon row-action modify"
                                                        ToolTip.Tip="Modifier le marché"
                                                        IsEnabled="{Binding $parent[UserControl].DataContext.PeutAgir}"
                                                        Command="{Binding $parent[UserControl].DataContext.ModifierMarcheCommand}"
                                                        CommandParameter="{Binding}">
                                                    <PathIcon Data="{x:Static vm:Icones.Modifier}" Width="18" Height="18" />
                                                </Button>
                                                <Button Classes="icon row-action delete"
                                                        ToolTip.Tip="Supprimer ce marché"
                                                        IsEnabled="{Binding $parent[UserControl].DataContext.PeutAgir}"
                                                        Command="{Binding $parent[UserControl].DataContext.SupprimerMarcheCommand}"
                                                        CommandParameter="{Binding}">
                                                    <PathIcon Data="{x:Static vm:Icones.Supprimer}" Width="18" Height="18" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- =====================================================================
             ÉCRAN 2 : DÉTAIL D'UN MARCHÉ (apparaît après « Ouvrir »)
             ===================================================================== -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="14"
              IsVisible="{Binding EstEnVueDetail}">

            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel Spacing="6">
                    <Button Content="← Retour aux marchés" Classes="ghost" HorizontalAlignment="Left"
                            Command="{Binding RetourListeCommand}" />
                    <TextBlock Classes="page-title" Text="{Binding TitreDetailMarche}" />
                    <TextBlock Classes="page-subtitle" Text="{Binding MarcheSelectionne.ObjetMarche}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                           MaxWidth="680" HorizontalAlignment="Right">
                    <Button Content="Modifier le marché"
                            Command="{Binding ModifierMarcheCommand}" Classes="ghost"
                            IsEnabled="{Binding PeutAgir}" Margin="0,0,8,8" />
                    <Button Content="Supprimer ce marché"
                            Command="{Binding SupprimerMarcheCommand}" Classes="danger"
                            IsEnabled="{Binding PeutAgir}" Margin="0,0,8,8" />
                    <Button Content="Recalculer les montants"
                            Command="{Binding RecalculerMontantsCommand}" Classes="ghost"
                            IsEnabled="{Binding PeutAgir}" Margin="0,0,8,8" />
                    <Button Content="Ajouter un élément"
                            Command="{Binding AjouterElementCommand}" Classes="accent"
                            IsEnabled="{Binding PeutAgir}" Margin="0,0,0,8" />
                </WrapPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="14" Margin="0,0,12,0">

                    <Border Classes="panel">
                        <Grid ColumnDefinitions="2*,2*,*,*" ColumnSpacing="16">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Classes="field-label" Text="Dossier DAO" />
                                <TextBlock Text="{Binding DossierAffiche}"
                                           TextWrapping="Wrap" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Classes="field-label" Text="Titulaire" />
                                <TextBlock Text="{Binding TitulaireAffiche}"
                                           TextWrapping="Wrap" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock Classes="field-label" Text="Délai d'exécution" />
                                <TextBlock Text="{Binding DelaiAffiche}" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Spacing="2">
                                <TextBlock Classes="field-label" Text="Statut" />
                                <TextBlock Text="{Binding MarcheSelectionne.StatutExecution, Converter={StaticResource EnumLibelle}}"
                                           FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <Border Grid.Column="0" Classes="stat">
                            <Grid ColumnDefinitions="4,*">
                                <Border Classes="stat-bar" />
                                <StackPanel Grid.Column="1" Spacing="2" Margin="16,14">
                                    <TextBlock Classes="kpi-label" Text="Éléments du bordereau" />
                                    <TextBlock Classes="stat-value" Text="{Binding NombreElements}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Classes="stat">
                            <Grid ColumnDefinitions="4,*">
                                <Border Classes="stat-bar" />
                                <StackPanel Grid.Column="1" Spacing="2" Margin="16,14">
                                    <TextBlock Classes="kpi-label" Text="Montant HT" />
                                    <TextBlock Classes="stat-value" Text="{Binding MontantHtAffiche}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Classes="stat">
                            <Grid ColumnDefinitions="4,*">
                                <Border Classes="stat-bar" />
                                <StackPanel Grid.Column="1" Spacing="2" Margin="16,14">
                                    <TextBlock Classes="kpi-label" Text="Montant TTC" />
                                    <TextBlock Classes="stat-value" Text="{Binding MontantTtcAffiche}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Classes="card">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Classes="section-title"
                                       Text="Bordereau du marché" Margin="0,0,0,10" />

                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                        Spacing="8" Margin="0,0,0,10">
                                <Button Content="Ajouter un élément"
                                        Command="{Binding AjouterElementCommand}"
                                        Classes="accent">
                                    <Button.IsEnabled>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="PeutAgir" />
                                            <Binding Path="AUnMarche" />
                                        </MultiBinding>
                                    </Button.IsEnabled>
                                </Button>
                                <Button Content="Recalculer les montants"
                                        Command="{Binding RecalculerMontantsCommand}"
                                        Classes="ghost">
                                    <Button.IsEnabled>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="PeutAgir" />
                                            <Binding Path="AUnMarche" />
                                        </MultiBinding>
                                    </Button.IsEnabled>
                                </Button>
                            </StackPanel>

                            <Border DockPanel.Dock="Top" Classes="empty-state"
                                    IsVisible="{Binding !NombreElements}">
                                <StackPanel Spacing="10" HorizontalAlignment="Center">
                                    <TextBlock Text="Ce marché ne contient encore aucun élément au bordereau."
                                               FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Classes="muted" HorizontalAlignment="Center"
                                               Text="Ajoutez les articles, fournitures ou prestations du contrat." />
                                    <Button Content="Ajouter un élément" Classes="accent"
                                            HorizontalAlignment="Center"
                                            Command="{Binding AjouterElementCommand}">
                                        <Button.IsEnabled>
                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                <Binding Path="PeutAgir" />
                                                <Binding Path="AUnMarche" />
                                            </MultiBinding>
                                        </Button.IsEnabled>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Border DockPanel.Dock="Bottom" Classes="total-band">
                                <Grid ColumnDefinitions="*,150,88" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Text="Total du bordereau (HT)" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding TotalBordereauAffiche}"
                                               FontWeight="Bold" HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </Grid>
                            </Border>

                            <Border DockPanel.Dock="Top" Classes="list-header">
                                <Grid ColumnDefinitions="90,*,120,80,70,140,88" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Text="Code" />
                                    <TextBlock Grid.Column="1" Text="Libellé" />
                                    <TextBlock Grid.Column="2" Text="Prix unitaire" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="Qté" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="Unité" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="Montant" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="6" Text="Actions" HorizontalAlignment="Center" />
                                </Grid>
                            </Border>

                            <ListBox ItemsSource="{Binding Elements}" SelectedItem="{Binding ElementSelectionne}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="ent:ElementMarche">
                                        <Grid ColumnDefinitions="90,*,120,80,70,140,88" ColumnSpacing="8"
                                              MinHeight="48" VerticalAlignment="Center">
                                            <TextBlock Grid.Column="0" Text="{Binding CodeElement}"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Libelle}" TextWrapping="Wrap"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding PrixUnitaire, StringFormat='{}{0:N0} Ar'}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Quantite, StringFormat='x {0:N2}'}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding Unite}" Classes="muted"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="5"
                                                       Text="{Binding MontantLigne, StringFormat='{}{0:N0} Ar'}"
                                                       FontWeight="SemiBold" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="6" Orientation="Horizontal"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                                <Button Classes="icon row-action modify"
                                                        ToolTip.Tip="Modifier l'élément"
                                                        IsEnabled="{Binding $parent[UserControl].DataContext.PeutAgir}"
                                                        Command="{Binding $parent[UserControl].DataContext.ModifierElementCommand}"
                                                        CommandParameter="{Binding}">
                                                    <PathIcon Data="{x:Static vm:Icones.Modifier}"
                                                              Width="18" Height="18" />
                                                </Button>
                                                <Button Classes="icon row-action delete"
                                                        ToolTip.Tip="Supprimer l'élément"
                                                        IsEnabled="{Binding $parent[UserControl].DataContext.PeutAgir}"
                                                        Command="{Binding $parent[UserControl].DataContext.SupprimerElementCommand}"
                                                        CommandParameter="{Binding}">
                                                    <PathIcon Data="{x:Static vm:Icones.Supprimer}"
                                                              Width="18" Height="18" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
