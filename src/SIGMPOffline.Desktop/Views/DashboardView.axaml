<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SIGMPOffline.Desktop.ViewModels"
             xmlns:models="using:SIGMPOffline.Services.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="SIGMPOffline.Desktop.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <ScrollViewer>
        <StackPanel Spacing="18">

            <!-- En-tête -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                    <TextBlock Classes="page-title" Text="Tableau de bord" />
                    <TextBlock Classes="page-subtitle"
                               Text="Vue d'ensemble des marchés et alertes de dépassement de délai." />
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost" Content="Actualiser"
                        Command="{Binding ChargerCommand}" VerticalAlignment="Top" />
            </Grid>

            <!-- Indicateurs clés -->
            <WrapPanel Orientation="Horizontal">

                <Border Classes="card" Width="232" Margin="0,0,12,12">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Border Width="46" Height="46" CornerRadius="10" VerticalAlignment="Center"
                                Background="{DynamicResource AccentSubtleBrush}">
                            <PathIcon Width="20" Height="20"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{DynamicResource AccentBrush}"
                                      Data="M4 4 H11 V11 H4 Z M13 4 H20 V11 H13 Z M4 13 H11 V20 H4 Z M13 13 H20 V20 H13 Z" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Classes="kpi-label" Text="Marchés" />
                            <TextBlock Classes="kpi-value" Text="{Binding TotalMarches}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="card" Width="232" Margin="0,0,12,12">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Border Width="46" Height="46" CornerRadius="10" VerticalAlignment="Center"
                                Background="{DynamicResource InfoSurfaceBrush}">
                            <PathIcon Width="18" Height="18"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{DynamicResource InfoBrush}"
                                      Data="M8 5 L19 12 L8 19 Z" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Classes="kpi-label" Text="En cours" />
                            <TextBlock Classes="kpi-value" Text="{Binding MarchesEnCours}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="card" Width="232" Margin="0,0,12,12">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Border Width="46" Height="46" CornerRadius="10" VerticalAlignment="Center"
                                Background="{DynamicResource SuccessSurfaceBrush}">
                            <PathIcon Width="20" Height="20"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{DynamicResource SuccessBrush}"
                                      Data="M10 16.2 L4.8 11 L6.2 9.6 L10 13.4 L17.8 5.6 L19.2 7 Z" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Classes="kpi-label" Text="Clôturés" />
                            <TextBlock Classes="kpi-value" Text="{Binding MarchesClotures}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="card" Width="232" Margin="0,0,12,12">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Border Width="46" Height="46" CornerRadius="10" VerticalAlignment="Center"
                                Background="{DynamicResource DangerSurfaceBrush}">
                            <PathIcon Width="20" Height="20"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{DynamicResource DangerBrush}"
                                      Data="M12 3 L22 20 H2 Z" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Classes="kpi-label" Text="En retard" />
                            <TextBlock Classes="kpi-value" Text="{Binding MarchesEnRetard}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </WrapPanel>

            <!-- Montant total -->
            <Border Classes="card">
                <StackPanel Spacing="4">
                    <TextBlock Classes="kpi-label" Text="Montant total des marchés (HT)" />
                    <TextBlock Classes="kpi-value"
                               Text="{Binding MontantTotalHt, StringFormat='{}{0:N0} FCFA'}" />
                </StackPanel>
            </Border>

            <!-- Erreur -->
            <Border Classes="error"
                    IsVisible="{Binding Erreur, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding Erreur}" TextWrapping="Wrap" />
            </Border>

            <!-- Alertes -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Classes="section-title" Text="Alertes de dépassement de délai" />

                    <Border Classes="success" IsVisible="{Binding !Alertes.Count}">
                        <TextBlock Text="Aucun marché en retard. 👍" />
                    </Border>

                    <ItemsControl ItemsSource="{Binding Alertes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:AlerteRetard">
                                <Border Background="{DynamicResource DangerSurfaceBrush}"
                                        BorderBrush="{DynamicResource DangerBorderBrush}"
                                        BorderThickness="1" CornerRadius="8"
                                        Padding="14,10" Margin="0,3">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding RefMarche}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding ObjetMarche}" Classes="muted"
                                                       FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="14,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="{Binding DateLimite, StringFormat='Limite : {0:dd/MM/yyyy}'}" />
                                        <Border Grid.Column="2" Classes="badge danger" Padding="10,3">
                                            <TextBlock Text="{Binding JoursDeRetard, StringFormat='+{0} j'}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
