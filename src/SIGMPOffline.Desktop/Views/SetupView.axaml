<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SIGMPOffline.Desktop.ViewModels"
             xmlns:ctrl="using:SIGMPOffline.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
             x:Class="SIGMPOffline.Desktop.Views.SetupView"
             x:DataType="vm:SetupViewModel">

    <!--
        Assistant de première configuration.
        Mise en page en une colonne limitée en largeur : confortable sur grand
        écran et parfaitement lisible sur une fenêtre étroite.
    -->
    <Border Classes="auth-backdrop">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Padding="16,24">
            <Border Classes="auth-card"
                    MaxWidth="520"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,*">

                    <Border Grid.Row="0" Classes="auth-stripe" Height="5" />

                    <StackPanel Grid.Row="1" Margin="28,18,28,18" Spacing="14">

                        <!-- Marque -->
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Classes="auth-logo" Width="42" Height="42">
                                <PathIcon Data="{x:Static vm:Icones.Marche}"
                                          Width="19" Height="19"
                                          Foreground="{DynamicResource TextOnAccentBrush}" />
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <TextBlock Classes="auth-brand" Text="SIGMP Offline" />
                                <TextBlock Classes="auth-caption" Text="Suivi des Marchés Publics" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Titre -->
                        <StackPanel Spacing="6">
                            <TextBlock Classes="auth-title" Text="Première configuration" />
                            <TextBlock Classes="auth-subtitle"
                                       Text="Cette étape n'est réalisée qu'une seule fois. Le nom du responsable PRMP servira d'identifiant au compte administrateur. Créez ensuite la première province." />
                        </StackPanel>

                        <!-- Étape 1 : responsable -->
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Classes="auth-step">
                                    <TextBlock Text="1" />
                                </Border>
                                <TextBlock Classes="auth-section" Text="RESPONSABLE PRMP" />
                            </StackPanel>

                            <StackPanel Spacing="7">
                                <TextBlock Classes="field-label">
                                    Responsable PRMP / Propriétaire
                                    <Run Foreground="{DynamicResource DangerBrush}">*</Run>
                                </TextBlock>
                                <Border Classes="auth-field"
                                        Classes.invalide="{Binding NomProprietaireInvalide}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <PathIcon Grid.Column="0"
                                                  Data="{x:Static vm:Icones.Utilisateur}"
                                                  Width="16" Height="16"
                                                  VerticalAlignment="Center"
                                                  Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBox Grid.Column="1" Classes="auth-input"
                                                 Text="{Binding NomProprietaire}"
                                                 PlaceholderText="ex. PRMP Jean Dupont"
                                                 AutomationProperties.Name="Responsable PRMP" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Étape 2 : province -->
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Classes="auth-step">
                                    <TextBlock Text="2" />
                                </Border>
                                <TextBlock Classes="auth-section" Text="PROVINCE &amp; ACCÈS" />
                            </StackPanel>

                            <StackPanel Spacing="7">
                                <TextBlock Classes="field-label">
                                    Nom de la province
                                    <Run Foreground="{DynamicResource DangerBrush}">*</Run>
                                </TextBlock>
                                <Border Classes="auth-field"
                                        Classes.invalide="{Binding NomProvinceInvalide}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <PathIcon Grid.Column="0"
                                                  Data="{x:Static vm:Icones.Province}"
                                                  Width="16" Height="16"
                                                  VerticalAlignment="Center"
                                                  Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBox Grid.Column="1" Classes="auth-input"
                                                 Text="{Binding NomProvince}"
                                                 PlaceholderText="ex. Province d'Antananarivo"
                                                 AutomationProperties.Name="Nom de la province" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="7">
                                <TextBlock Classes="field-label">
                                    Mot de passe administrateur
                                    <Run Foreground="{DynamicResource DangerBrush}">*</Run>
                                </TextBlock>
                                <ctrl:PasswordField Text="{Binding MotDePasse, Mode=TwoWay}"
                                                    PlaceholderText="Saisissez un mot de passe"
                                                    NomAccessible="Mot de passe administrateur"
                                                    EstInvalide="{Binding MotDePasseInvalide}" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="auth-help"
                                               Text="{Binding LongueurMinMotDePasse, StringFormat='{}{0} caractères minimum'}" />
                                    <PathIcon Data="{x:Static vm:Icones.Validation}"
                                              Width="12" Height="12"
                                              VerticalAlignment="Center"
                                              Foreground="{DynamicResource SuccessBrush}"
                                              IsVisible="{Binding MotDePasseSuffisant}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="7">
                                <TextBlock Classes="field-label" Text="Confirmation du mot de passe" />
                                <ctrl:PasswordField Text="{Binding Confirmation, Mode=TwoWay}"
                                                    PlaceholderText="Ressaisissez le mot de passe"
                                                    NomAccessible="Confirmation du mot de passe"
                                                    EstInvalide="{Binding ConfirmationInvalide}" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="auth-help" Text="Les mots de passe doivent être identiques" />
                                    <PathIcon Data="{x:Static vm:Icones.Validation}"
                                              Width="12" Height="12"
                                              VerticalAlignment="Center"
                                              Foreground="{DynamicResource SuccessBrush}"
                                              IsVisible="{Binding MotsDePasseConcordent}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Message d'erreur -->
                        <Border Classes="error"
                                IsVisible="{Binding Erreur, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <PathIcon Grid.Column="0"
                                          Data="{x:Static vm:Icones.Alerte}"
                                          Width="15" Height="15"
                                          VerticalAlignment="Top" Margin="0,1,0,0"
                                          Foreground="{DynamicResource DangerBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Erreur}" TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <Border Classes="divider" />

                        <!-- Actions -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Button Grid.Column="0" Classes="ghost" Content="Quitter"
                                    VerticalAlignment="Center"
                                    Command="{Binding QuitterCommand}"
                                    AutomationProperties.Name="Quitter l'application" />

                            <Button Grid.Column="2" Classes="accent auth-primary"
                                    Classes.chargement="{Binding EstOccupe}"
                                    Command="{Binding TerminerCommand}"
                                    IsEnabled="{Binding !EstOccupe}"
                                    IsDefault="True"
                                    Padding="24,0"
                                    AutomationProperties.Name="Terminer la configuration">
                                <StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Center">
                                    <PathIcon Classes="spinner"
                                              Data="{x:Static vm:Icones.Actualiser}"
                                              Width="15" Height="15"
                                              IsVisible="{Binding EstOccupe}"
                                              Foreground="{DynamicResource TextOnAccentBrush}" />
                                    <TextBlock Text="Terminer"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextOnAccentBrush}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                    </StackPanel>
                </Grid>
            </Border>
        </ScrollViewer>
    </Border>
</UserControl>
