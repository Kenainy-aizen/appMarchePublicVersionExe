<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SIGMPOffline.Desktop.ViewModels"
             xmlns:ent="using:SIGMPOffline.Domain.Entities"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="650"
             x:Class="SIGMPOffline.Desktop.Views.SuiviView"
             x:DataType="vm:SuiviViewModel">

    <Grid RowDefinitions="Auto,*" RowSpacing="14">

        <!-- En-tête -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
                <TextBlock Classes="page-title" Text="Suivi d'exécution" />
                <TextBlock Classes="page-subtitle" Text="Ordres de service, TEF, réceptions, avenants et clôture." />
            </StackPanel>
            <Button Grid.Column="1" Classes="ghost" Content="Actualiser"
                    Command="{Binding ChargerCommand}" VerticalAlignment="Top" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="300,*" ColumnSpacing="14">

            <!-- Liste des marchés -->
            <Border Classes="card">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="section-title" Text="Marchés" Margin="0,0,0,10" />
                    <ListBox ItemsSource="{Binding Marches}" SelectedItem="{Binding MarcheSelectionne}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="ent:Marche">
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding RefMarche}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ObjetMarche}" Classes="muted"
                                               FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1">
                <StackPanel Spacing="12">

                    <!-- Messages -->
                    <Border Classes="error" IsVisible="{Binding Erreur, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding Erreur}" TextWrapping="Wrap" />
                    </Border>
                    <Border Classes="success" IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                    </Border>

                    <!-- Situation d'exécution -->
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="section-title" Text="Situation d'exécution" />

                            <Grid ColumnDefinitions="230,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="field-label" Text="Objet du marché" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Situation.ObjetMarche}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="field-label" Text="Ordre de service (OS)" />
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{Binding Situation.DateOS, StringFormat='{}{0:dd/MM/yyyy}', TargetNullValue='Non émis'}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Classes="field-label" Text="Titre d'engagement financier" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Situation.RefTef, TargetNullValue='—'}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Classes="field-label" Text="Date limite d'exécution" />
                                <TextBlock Grid.Row="3" Grid.Column="1"
                                           Text="{Binding Situation.DateLimiteExecution, StringFormat='{}{0:dd/MM/yyyy}', TargetNullValue='—'}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Classes="field-label" Text="Jours restants" />
                                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{Binding Situation.JoursRestants, TargetNullValue='—'}" VerticalAlignment="Center" />
                                    <Border Classes="badge danger" IsVisible="{Binding Situation.EstEnRetard}">
                                        <TextBlock Text="En retard" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Grid.Row="5" Grid.Column="0" Classes="field-label" Text="Statut" />
                                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{Binding Situation.Statut, Converter={StaticResource EnumLibelle}}" VerticalAlignment="Center" />
                                    <Border Classes="badge success" IsVisible="{Binding Situation.EstCloture}">
                                        <TextBlock Text="Clôturé" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Actions -->
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="section-title" Text="Actions" />
                            <WrapPanel Orientation="Horizontal" IsEnabled="{Binding PeutModifier}">
                                <Button Content="Émettre l'OS" Command="{Binding EmettreOsCommand}" Margin="0,0,8,8" />
                                <Button Content="Enregistrer le TEF" Command="{Binding EnregistrerTefCommand}" Margin="0,0,8,8" />
                                <Button Content="Réception provisoire" Command="{Binding ReceptionProvisoireCommand}" Margin="0,0,8,8" />
                                <Button Content="Réception définitive" Command="{Binding ReceptionDefinitiveCommand}" Margin="0,0,8,8" />
                                <Button Content="Clôturer le marché" Command="{Binding CloturerCommand}" Classes="accent" Margin="0,0,8,8" />
                            </WrapPanel>
                            <Border Classes="success" IsVisible="{Binding Situation.EstCloture}">
                                <TextBlock Text="Ce marché est clôturé : aucune nouvelle action n'est possible." TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Avenants -->
                    <Border Classes="card">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,10">
                                <TextBlock Classes="section-title" Text="Avenants" />
                                <WrapPanel Orientation="Horizontal" IsEnabled="{Binding PeutModifier}">
                                    <Button Content="Ajouter" Command="{Binding AjouterAvenantCommand}" Classes="accent" Margin="0,0,8,0" />
                                    <Button Content="Modifier" Command="{Binding ModifierAvenantCommand}"
                                            IsEnabled="{Binding AUnAvenant}" Margin="0,0,8,0" />
                                    <Button Content="Supprimer" Command="{Binding SupprimerAvenantCommand}"
                                            IsEnabled="{Binding AUnAvenant}" Classes="danger" />
                                </WrapPanel>
                            </StackPanel>

                            <Border DockPanel.Dock="Top" Classes="list-header">
                                <Grid ColumnDefinitions="110,120,*,160,130">
                                    <TextBlock Grid.Column="0" Text="N°" />
                                    <TextBlock Grid.Column="1" Text="Date" />
                                    <TextBlock Grid.Column="2" Text="Motif" />
                                    <TextBlock Grid.Column="3" Text="Variation" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="Délai" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>

                            <ListBox ItemsSource="{Binding Avenants}" SelectedItem="{Binding AvenantSelectionne}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="ent:Avenant">
                                        <Grid ColumnDefinitions="110,120,*,160,130">
                                            <TextBlock Grid.Column="0" Text="{Binding NumAvenant}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DateAvenant, StringFormat='{}{0:dd/MM/yyyy}'}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Motif}" Classes="muted" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding VariationMontant, StringFormat='{}{0:N0} Ar'}"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding ProlongationDelaiJours, StringFormat='{}{0:+0;-0;0} j'}"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
