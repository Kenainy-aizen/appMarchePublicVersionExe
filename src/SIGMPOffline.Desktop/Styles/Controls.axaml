<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Bibliothèque de styles réutilisables — SIGMP Offline.

        Règles :
          • aucune couleur ni taille en dur ici : tout vient de Palette.axaml ;
          • les couleurs passent par {DynamicResource} pour que la bascule clair/sombre
            soit instantanée ;
          • les vues utilisent les classes (.titre, .secondaire, .accent, .card, …).
    -->

    <!-- =========================================================
         POLICE GLOBALE
         La police est posée sur la fenêtre et se propage par héritage
         (TextElement.FontFamily/FontSize sont des propriétés héritées).
         ========================================================= -->
    <Style Selector="Window">
        <Setter Property="TextElement.FontFamily" Value="{DynamicResource PolicePrincipale}" />
        <Setter Property="TextElement.FontSize" Value="{DynamicResource TailleTexteBase}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource PolicePrincipale}" />
        <Setter Property="FontSize" Value="{DynamicResource TailleTexteBase}" />
    </Style>

    <!-- =========================================================
         TYPOGRAPHIE — classes réutilisables
         ========================================================= -->
    <Style Selector="TextBlock.titre, TextBlock.page-title">
        <Setter Property="FontSize" Value="{DynamicResource TailleTitrePage}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.section, TextBlock.section-title">
        <Setter Property="FontSize" Value="{DynamicResource TailleTitreSection}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="TextBlock.page-subtitle, TextBlock.secondaire">
        <Setter Property="FontSize" Value="{DynamicResource TailleTexteSecondaire}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.legende">
        <Setter Property="FontSize" Value="{DynamicResource TailleLegende}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <Style Selector="TextBlock.kpi-label">
        <Setter Property="FontSize" Value="{DynamicResource TailleTexteSecondaire}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <Style Selector="TextBlock.kpi-value">
        <Setter Property="FontSize" Value="{DynamicResource TailleKpi}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <Style Selector="TextBlock.field-label">
        <Setter Property="FontSize" Value="{DynamicResource TailleTexteSecondaire}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.dialog-title">
        <Setter Property="FontSize" Value="{DynamicResource TailleTitreDialogue}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- Texte d'accent (lien, valeur mise en avant). -->
    <Style Selector="TextBlock.accent">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="Border.divider">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
    </Style>

    <!-- =========================================================
         BOUTONS
         ========================================================= -->
    <Style Selector="Button">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="FontSize" Value="{DynamicResource TailleBouton}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- Bouton neutre (secondaire) : surface + contour, lisible dans les deux thèmes. -->
    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <!-- Anneau de focus clavier (AA : le contour accent reste visible sur les deux fonds). -->
    <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- Bouton principal (accent plein). -->
    <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSurfaceHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    </Style>
    <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSurfacePressedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    </Style>
    <Style Selector="Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
    </Style>
    <Style Selector="Button.accent:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource TextOnAccentBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- Bouton de suppression (danger, contour). -->
    <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerPressedBrush}" />
    </Style>
    <Style Selector="Button.danger:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Bouton discret (ghost / secondaire sans contour). -->
    <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    </Style>

    <!-- Bouton icône (carré), réutilisable dans les listes. -->
    <Style Selector="Button.icon">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Actions discrètes sur une ligne (modification / suppression). -->
    <Style Selector="Button.row-action">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.row-action /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.row-action.modify /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.row-action.modify:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
    </Style>
    <Style Selector="Button.row-action.delete /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Button.row-action.delete:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerHoverBrush}" />
    </Style>

    <!-- Bouton discret sur fond sombre (barre latérale). -->
    <Style Selector="Button.sidebar /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPanel}" />
    </Style>
    <Style Selector="Button.sidebar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarTextActiveBrush}" />
    </Style>
    <Style Selector="Button.sidebar:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SidebarActiveBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarTextActiveBrush}" />
    </Style>

    <!-- =========================================================
         CHAMPS DE SAISIE
         ========================================================= -->
    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="{DynamicResource TailleTexteBase}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentSubtleBrush}" />
        <Setter Property="PlaceholderForeground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBox:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
    </Style>
    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBox:disabled">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="{DynamicResource TailleTexteBase}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="PlaceholderForeground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
    </Style>
    <Style Selector="ComboBox:focus /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ComboBox:disabled">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
    </Style>

    <!-- Liste déroulante : items lisibles, survol thémé. -->
    <Style Selector="ComboBoxItem">
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontSize" Value="{DynamicResource TailleTexteBase}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="NumericUpDown">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="FontSize" Value="{DynamicResource TailleTexteBase}" />
    </Style>

    <Style Selector="DatePicker">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontSize" Value="{DynamicResource TailleTexteBase}" />
    </Style>

    <!-- =========================================================
         MENUS (Menu / MenuItem / menu contextuel)
         ========================================================= -->
    <Style Selector="Menu">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="{DynamicResource TailleTexteBase}" />
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="FontSize" Value="{DynamicResource TailleTexteBase}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="MenuItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="MenuItem:pressed">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
    </Style>
    <Style Selector="MenuItem:disabled">
        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
    </Style>
    <Style Selector="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource TailleTexteBase}" />
    </Style>

    <!-- =========================================================
         CARTES & PANNEAUX
         ========================================================= -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPanel}" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <!-- =========================================================
         ENCARTS DE MESSAGE (erreur / succès / avertissement / info)
         ========================================================= -->
    <Style Selector="Border.error">
        <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPanel}" />
        <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Border.error TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>

    <Style Selector="Border.success">
        <Setter Property="Background" Value="{DynamicResource SuccessSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPanel}" />
        <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Border.success TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    </Style>

    <Style Selector="Border.warning">
        <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPanel}" />
        <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Border.warning TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    </Style>

    <Style Selector="Border.info">
        <Setter Property="Background" Value="{DynamicResource InfoSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InfoBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPanel}" />
        <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Border.info TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
    </Style>

    <!-- =========================================================
         LISTES (tableaux) & EN-TÊTES DE COLONNES
         ========================================================= -->
    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="FontSize" Value="{DynamicResource TailleTexteBase}" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
    </Style>
    <Style Selector="ListBoxItem:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
    </Style>

    <!-- En-tête de tableau (équivalent DataGrid des vues liste). -->
    <Style Selector="Border.list-header">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="Border.list-header TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource TailleEnteteGrille}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- =========================================================
         BADGES DE STATUT
         ========================================================= -->
    <Style Selector="Border.badge">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.badge TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource TailleEnteteGrille}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Border.badge.success">
        <Setter Property="Background" Value="{DynamicResource SuccessSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
    </Style>
    <Style Selector="Border.badge.success TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    </Style>

    <Style Selector="Border.badge.danger">
        <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
    </Style>
    <Style Selector="Border.badge.danger TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>

    <Style Selector="Border.badge.info">
        <Setter Property="Background" Value="{DynamicResource InfoSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InfoBorderBrush}" />
    </Style>
    <Style Selector="Border.badge.info TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
    </Style>

    <Style Selector="Border.badge.warning">
        <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
    </Style>
    <Style Selector="Border.badge.warning TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    </Style>

    <!-- =========================================================
         BARRE LATÉRALE (typographie sur fond sombre)
         ========================================================= -->
    <Style Selector="TextBlock.sidebar-logo">
        <Setter Property="FontSize" Value="{DynamicResource TailleLogo}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    </Style>
    <Style Selector="TextBlock.sidebar-brand">
        <Setter Property="FontSize" Value="{DynamicResource TailleTitreSection}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarTextActiveBrush}" />
    </Style>
    <Style Selector="TextBlock.sidebar-brand-sub">
        <Setter Property="FontSize" Value="{DynamicResource TailleLegende}" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.sidebar-meta">
        <Setter Property="FontSize" Value="{DynamicResource TailleLegende}" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.sidebar-province">
        <Setter Property="FontSize" Value="{DynamicResource TailleTitreSection}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- =========================================================
         MENU LATÉRAL (navigation)
         ========================================================= -->
    <Style Selector="ListBox.nav">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem">
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPanel}" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarTextActiveBrush}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SidebarActiveBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarTextActiveBrush}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SidebarActiveBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarTextActiveBrush}" />
    </Style>

</Styles>
