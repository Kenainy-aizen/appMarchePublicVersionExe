<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SIGMPOffline.Desktop.ViewModels"
             x:Class="SIGMPOffline.Desktop.Controls.PasswordField"
             Focusable="False">

    <!--
        Champ de mot de passe réutilisable.
        L'icône « œil » est superposée à droite de la zone de saisie : la mise en
        page du champ ne change donc jamais lorsque l'on affiche/masque la valeur.
        Les deux tracés (œil ouvert / œil barré) partagent le même canevas 24 × 24
        afin de rester parfaitement alignés lors du changement d'état.
        La logique de synchronisation se trouve dans PasswordField.axaml.cs.
    -->
    <Border Name="PART_Cadre" Classes="auth-field" Padding="13,0,5,0">
        <Grid ColumnDefinitions="*,Auto">
            <TextBox Name="PART_Saisie"
                     Grid.Column="0"
                     Classes="auth-input"
                     PasswordChar="●"
                     Padding="0,0,6,0"
                     VerticalContentAlignment="Center" />

            <Button Name="PART_Bascule"
                    Grid.Column="1"
                    Classes="password-toggle"
                    VerticalAlignment="Center"
                    Cursor="Hand"
                    ToolTip.Tip="Afficher le mot de passe">
                <Viewbox Width="20" Height="20" Stretch="Uniform">
                    <Canvas Width="24" Height="24">
                        <Path Name="PART_Oeil"
                              Data="{x:Static vm:Icones.OeilTrait}"
                              Fill="Transparent"
                              Stroke="{DynamicResource TextSecondaryBrush}"
                              StrokeThickness="1.8"
                              StrokeLineCap="Round"
                              StrokeJoin="Round">
                            <Path.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                                </Transitions>
                            </Path.Transitions>
                        </Path>

                        <Path Name="PART_OeilBarre"
                              Data="{x:Static vm:Icones.OeilBarreTrait}"
                              Opacity="0"
                              Fill="Transparent"
                              Stroke="{DynamicResource TextSecondaryBrush}"
                              StrokeThickness="1.8"
                              StrokeLineCap="Round"
                              StrokeJoin="Round">
                            <Path.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                                </Transitions>
                            </Path.Transitions>
                        </Path>
                    </Canvas>
                </Viewbox>
            </Button>
        </Grid>
    </Border>
</UserControl>
