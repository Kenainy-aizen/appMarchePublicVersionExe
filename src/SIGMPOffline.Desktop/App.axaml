<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SIGMPOffline.Desktop.App"
             xmlns:local="using:SIGMPOffline.Desktop"
             xmlns:conv="using:SIGMPOffline.Desktop.Converters"
             RequestedThemeVariant="Light">
             <!-- Thème clair par défaut ; la bascule manuelle reste proposée dans la barre latérale. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://SIGMPOffline.Desktop/Styles/Palette.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:EnumLibelleConverter x:Key="EnumLibelle" />
            <conv:PpmMontantTotalConverter x:Key="PpmMontantTotal" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://SIGMPOffline.Desktop/Styles/Controls.axaml" />
        <StyleInclude Source="avares://SIGMPOffline.Desktop/Styles/Auth.axaml" />
    </Application.Styles>
</Application>
