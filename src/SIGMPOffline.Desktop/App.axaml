<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SIGMPOffline.Desktop.App"
             xmlns:local="using:SIGMPOffline.Desktop"
             xmlns:conv="using:SIGMPOffline.Desktop.Converters"
             RequestedThemeVariant="Default">
             <!-- "Default" suit le thème du système ; la bascule manuelle est proposée dans la barre latérale. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://SIGMPOffline.Desktop/Styles/Palette.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:EnumLibelleConverter x:Key="EnumLibelle" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://SIGMPOffline.Desktop/Styles/Controls.axaml" />
    </Application.Styles>
</Application>
